mod hlpp_text
mod hlpp_map
mod hlpp_prog

pub fn magic() -> string is return "HLPB-IMAGE 1" end

pub struct Decoded is
    pub ok: bool
    pub err: string
    pub prog: hlpp_prog::Prog
end

;; ── escaping ────────────────────────────────────────────────────────────────
pub fn esc(s: string) -> string is
    let mut t: string = string_replace_all(s, "\\", "\\\\")
    t = string_replace_all(t, "\n", "\\n")
    t = string_replace_all(t, "\r", "\\r")
    return t
end

pub fn unesc(s: string) -> string is
    if string_find(s, "\\") < 0 is return s end
    let mut out: string = ""
    let n: int = string_len(s)
    let mut i: int = 0
    while i < n is
        let c: string = string_slice(s, i, i + 1)
        if c == "\\" && i + 1 < n is
            let d: string = string_slice(s, i + 1, i + 2)
            if d == "n" is out = out + "\n"
            else if d == "r" is out = out + "\r"
            else is out = out + d end
            i += 2
        else is
            out = out + c
            i += 1
        end
    end
    return out
end

;; ── checksum ────────────────────────────────────────────────────────────────
pub fn checksum(s: string) -> int is
    let bs: [int] = string_to_bytes(s)
    let mut c: int = 7
    let mut i: int = 0
    while i < array_len(bs) is
        c = (c * 31 + bs[i] + 1) % 2147483647
        i += 1
    end
    return c
end

;; ── encode ──────────────────────────────────────────────────────────────────
fn ints_block(xs: [int]) -> string is
    let mut out: string = ""
    let mut line: string = ""
    let mut k: int = 0
    let mut i: int = 0
    while i < array_len(xs) is
        if k > 0 is line = line + " " end
        line = line + to_string(xs[i])
        k += 1
        if k == 16 is
            out = out + line + "\n"
            line = ""
            k = 0
        end
        i += 1
    end
    if k > 0 is out = out + line + "\n" end
    return out
end

pub fn encode(p: hlpp_prog::Prog) -> string is
    let mut s: string = magic() + "\n"
    s = s + "edition " + to_string(p.edition) + "\n"
    s = s + "gen " + to_string(p.gen) + "\n"
    let mut rl: int = 0
    if p.rolling is rl = 1 end
    s = s + "rolling " + to_string(rl) + "\n"
    s = s + "file " + esc(p.file) + "\n"
    s = s + "src " + esc(p.src) + "\n"
    s = s + "names " + to_string(array_len(p.names)) + "\n"
    let mut i: int = 0
    while i < array_len(p.names) is
        s = s + esc(p.names[i]) + "\n"
        i += 1
    end
    s = s + "lits " + to_string(array_len(p.lits)) + "\n"
    let mut j: int = 0
    while j < array_len(p.lits) is
        s = s + esc(p.lits[j]) + "\n"
        j += 1
    end
    s = s + "code " + to_string(array_len(p.code)) + "\n" + ints_block(p.code)
    s = s + "lines " + to_string(array_len(p.lines)) + "\n" + ints_block(p.lines)
    s = s + "checksum " + to_string(checksum(s)) + "\n"
    return s
end

;; ── decode ──────────────────────────────────────────────────────────────────
fn bad(msg: string) -> Decoded is
    return Decoded { ok: false, err: msg, prog: hlpp_prog::new_prog(0, "") }
end

fn field(line: string, key: string) -> string is
    if string_starts_with(line, key + " ") is return string_slice(line, string_len(key) + 1, string_len(line)) end
    if line == key is return "" end
    return "\u{1}"
end

pub fn decode(text: string) -> Decoded is
    let ck: int = string_rfind(text, "checksum ")
    if ck < 0 is return bad("not an HLPB image (no checksum line)") end
    let body: string = string_slice(text, 0, ck)
    let want: int = hlpp_text::int_or(string_trim(string_slice(text, ck + 9, string_len(text))), 0 - 1)
    if checksum(body) != want is return bad("corrupt image (checksum mismatch)") end
    let ls: [string] = string_split(body, "\n")
    let n: int = array_len(ls)
    if n < 8 || ls[0] != magic() is return bad("not an HLPB image (bad header, expected '" + magic() + "')") end
    let p: hlpp_prog::Prog = hlpp_prog::new_prog(0, "")
    let ed: string = field(ls[1], "edition")
    let gn: string = field(ls[2], "gen")
    let rl: string = field(ls[3], "rolling")
    let fl: string = field(ls[4], "file")
    let sr: string = field(ls[5], "src")
    if ed == "\u{1}" || gn == "\u{1}" || rl == "\u{1}" || fl == "\u{1}" || sr == "\u{1}" is return bad("malformed image header") end
    p.edition = hlpp_text::int_or(ed, 0)
    p.gen = hlpp_text::int_or(gn, 2)
    p.rolling = rl == "1"
    p.file = unesc(fl)
    p.src = unesc(sr)
    let mut at: int = 6
    let nk: string = field(ls[at], "names")
    if nk == "\u{1}" is return bad("missing names section") end
    let cnt_names: int = hlpp_text::int_or(nk, 0 - 1)
    at += 1
    if cnt_names < 0 || at + cnt_names >= n is return bad("truncated names section") end
    let mut i: int = 0
    while i < cnt_names is
        hlpp_prog::slot(p, unesc(ls[at + i]))
        i += 1
    end
    at += cnt_names
    let lk: string = field(ls[at], "lits")
    if lk == "\u{1}" is return bad("missing lits section") end
    let cnt_lits: int = hlpp_text::int_or(lk, 0 - 1)
    at += 1
    if cnt_lits < 0 || at + cnt_lits >= n is return bad("truncated lits section") end
    let mut j: int = 0
    while j < cnt_lits is
        hlpp_prog::lit(p, unesc(ls[at + j]))
        j += 1
    end
    at += cnt_lits
    ;; the literal / name tables are deduplicating: a duplicate entry would shift every index
    if array_len(p.names) != cnt_names || array_len(p.lits) != cnt_lits is return bad("duplicate entries in tables") end
    let ck2: string = field(ls[at], "code")
    if ck2 == "\u{1}" is return bad("missing code section") end
    let ncode: int = hlpp_text::int_or(ck2, 0 - 1)
    at += 1
    if ncode < 0 || ncode % 4 != 0 is return bad("bad code length") end
    let mut got: int = 0
    while got < ncode is
        if at >= n is return bad("truncated code section") end
        let ws: [string] = hlpp_text::words(ls[at])
        let mut w: int = 0
        while w < array_len(ws) is
            p.code = array_push(p.code, hlpp_text::int_or(ws[w], 0))
            w += 1
        end
        got += array_len(ws)
        at += 1
    end
    if got != ncode is return bad("code section size mismatch") end
    if at >= n is return bad("missing lines section") end
    let lk2: string = field(ls[at], "lines")
    if lk2 == "\u{1}" is return bad("missing lines section") end
    let nl: int = hlpp_text::int_or(lk2, 0 - 1)
    at += 1
    let mut gl: int = 0
    while gl < nl is
        if at >= n is return bad("truncated lines section") end
        let ws2: [string] = hlpp_text::words(ls[at])
        let mut w2: int = 0
        while w2 < array_len(ws2) is
            p.lines = array_push(p.lines, hlpp_text::int_or(ws2[w2], 0))
            w2 += 1
        end
        gl += array_len(ws2)
        at += 1
    end
    if nl != ncode / 4 is return bad("lines section does not match the code") end
    return Decoded { ok: true, err: "", prog: p }
end

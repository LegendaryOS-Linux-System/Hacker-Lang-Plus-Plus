mod aot_image
mod aot_plan
mod hlpp_prog

pub fn name() -> string is return "aot" end

;; native executables are not available yet
pub fn available() -> bool is return aot_plan::native_ready() end

pub fn reason() -> string is
    return "AOT jest placeholderem: działa etap 'image' (przenośny obraz HLPB), generowanie kodu natywnego dopiero planowane (hlpp aot status)"
end

pub fn status() -> string is
    if available() is return "backend aot: natywny" end
    return "backend aot (placeholder): obraz HLPB działa; kod natywny: planowany"
end

pub fn plan() -> string is return aot_plan::report() end

pub fn encode(p: hlpp_prog::Prog) -> string is return aot_image::encode(p) end

;; "" when `text` is a valid image, otherwise the reason
pub fn verify(text: string) -> string is return aot_image::decode(text).err end

pub fn load(text: string) -> hlpp_prog::Prog is return aot_image::decode(text).prog end

pub fn magic() -> string is return aot_image::magic() end

;; the backend names accepted by --backend= / HLPP_BACKEND
pub fn valid_backend(n: string) -> bool is
    return n == "jit" || n == "aot"
end

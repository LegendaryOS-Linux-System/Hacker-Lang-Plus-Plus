        if vm.trace is
            let tsp: int = vm.sp
            hlpp_sys::err("pc=" + to_string(pc) + " op=" + to_string(op) + " a=" + to_string(a) + " b=" + to_string(b) + " c=" + to_string(c) + " sp=" + to_string(tsp) + "\n")
        end
        if op == o_lit is
            hlpp_vm::push(vm, vm.p.lits[a])
        else if op == o_var is
            hlpp_vm::push(vm, hlpp_vm::get_var(vm, a))
        else if op == o_cat is
            let mut r: string = ""
            let mut i: int = vm.sp - a
            if i < 0 is i = 0 end
            while i < vm.sp is
                r = r + vm.stk[i]
                i += 1
            end
            vm.sp = vm.sp - a
            if vm.sp < 0 is vm.sp = 0 end
            hlpp_vm::push(vm, r)
        else if op == o_setlit is
            hlpp_vm::set_var(vm, a, vm.p.lits[b], c)
            setx(vm, 0)
        else if op == o_set is
            hlpp_vm::set_var(vm, a, hlpp_vm::pop(vm), b)
            setx(vm, 0)
        else if op == o_jmp is
            vm.pc = a
        else if op == o_cmpv is
            op_cmpv(vm, a, b, c)
        else if op == o_jfalse is
            if !vm.flag is vm.pc = a end
        else if op == o_jtrue is
            if vm.flag is vm.pc = a end
        else if op == o_jifok is
            if vm.last_exit == 0 is vm.pc = a end
        else if op == o_jiferr is
            if vm.last_exit != 0 is vm.pc = a end
        else if op == o_print is
            hlpp_sys::outln(hlpp_vm::pop(vm))
            setx(vm, 0)
        else if op == o_printlit is
            hlpp_sys::outln(vm.p.lits[a])
            setx(vm, 0)
        else if op == o_nbeg is
            vm.nsp = 0
            vm.nfail = false
        else if op == o_nlit is
            let nli: int = 0 - a - 1
            if int_kind(vm, nli) == 1 is
                hlpp_vm::npush(vm, vm.lit_i[a], 0)
            else is
                let nn: hlpp_num::Num = hlpp_num::parse(vm.p.lits[a])
                hlpp_vm::npush(vm, nn.m, nn.s)
            end
        else if op == o_nvar is
            op_nvar(vm, a)
        else if op == o_nbin is
            op_nbin(vm, a)
        else if op == o_nneg is
            if vm.nsp > 0 is vm.nm[vm.nsp - 1] = 0 - vm.nm[vm.nsp - 1] end
        else if op == o_nend is
            op_nend(vm, a, b)
        else if op == o_whtick is
            if vm.wcnt[vm.wsp - 1] >= wlimit is
                hlpp_vm::fail(vm, "Pętla while: przekroczono limit 1000000 iteracji")
            else is
                vm.wcnt[vm.wsp - 1] += 1
            end
        else if op == o_whinit is
            push_counter(vm, 0, 0)
        else if op == o_whend is
            if vm.wsp > 0 is vm.wsp -= 1 end
            setx(vm, 0)
        else if op == o_fornext is
            let f: int = vm.itsp - 1
            if vm.itf_pos[f] >= vm.itf_end[f] is
                vm.pc = b
            else is
                hlpp_vm::set_var(vm, a, vm.it_pool[vm.itf_pos[f]], 1)
                vm.itf_pos[f] += 1
            end
        else if op == o_forinit is
            word_frame_push(vm, hlpp_vm::pop(vm))
            setx(vm, 0)
        else if op == o_forend is
            if vm.itsp > 0 is
                vm.itsp -= 1
                vm.it_len = vm.itf_start[vm.itsp]
            end
        else if op == o_call is
            let nm: string = vm.p.lits[a]
            let at: int = hlpp_map::get(vm.fns, nm, 0 - 1)
            if at < 0 is
                hlpp_vm::fail(vm, "Niezdefiniowana funkcja: '" + nm + "'")
            else is
                enter_function(vm, at, 0)
            end
        else if op == o_ret is
            op_ret(vm)
        else if op == o_deffunc is
            hlpp_map::put(vm.fns, vm.p.lits[a], pc + 1)
            vm.pc = b
            setx(vm, 0)
        else if op == o_defarena is
            let key: string = "::" + vm.p.lits[a]
            hlpp_map::put(vm.fns, key, pc + 1)
            hlpp_map::put(vm.arena_sz, key, arena_bytes(vm.p.lits[c]))
            vm.pc = b
            setx(vm, 0)
        else if op == o_callarena is
            op_callarena(vm, vm.p.lits[a], hlpp_vm::pop(vm))
        else if op == o_quick is
            op_quick(vm, vm.p.lits[a], hlpp_vm::pop(vm), false, 0)
        else if op == o_quickcap is
            op_quick(vm, vm.p.lits[a], hlpp_vm::pop(vm), true, b)
        else if op == o_exec is
            op_exec(vm, hlpp_vm::pop(vm), a, b)
        else if op == o_execcap is
            op_execcap(vm, hlpp_vm::pop(vm), a, b)
        else if op == o_builtin is
            op_builtin(vm, hlpp_vm::pop(vm), false, 0)
        else if op == o_builtincap is
            op_builtin(vm, hlpp_vm::pop(vm), true, a)
        else if op == o_dyn is
            hlpp_vm::push(vm, hlpp_vm::get_dyn(vm, hlpp_vm::pop(vm)))
        else if op == o_cond is
            vm.flag = hlpp_rt::cond_string(vm, hlpp_vm::pop(vm))
        else if op == o_cmps is
            let r2: string = hlpp_vm::pop(vm)
            let l2: string = hlpp_vm::pop(vm)
            vm.flag = hlpp_rt::cmp_values(a, l2, r2)
        else if op == o_swbeg is
            push_switch(vm, hlpp_vm::pop(vm))
        else if op == o_swcmp is
            if vm.sws[vm.swsp - 1] == vm.p.lits[a] is vm.pc = b end
        else if op == o_swcmpi is
            let pat: string = vm.p.lits[a]
            if vm.sws[vm.swsp - 1] == pat || vm.sws[vm.swsp - 1] == hlpp_rt::interp(vm, pat) is vm.pc = b end
        else if op == o_swend is
            if vm.swsp > 0 is vm.swsp -= 1 end
            setx(vm, 0)
        else if op == o_rptinit is
            push_counter(vm, 1, a)
            setx(vm, 0)
        else if op == o_rptnext is
            if vm.rcnt[vm.rcsp - 1] <= 0 is
                vm.pc = a
            else is
                vm.rcnt[vm.rcsp - 1] -= 1
            end
        else if op == o_rptend is
            if vm.rcsp > 0 is vm.rcsp -= 1 end
        else if op == o_export is
            op_export(vm, a, hlpp_vm::pop(vm))
        else if op == o_dep is
            let dc: int = hlpp_rt::dep_check(vm, vm.p.lits[a], vm.p.lits[b])
            setx(vm, dc)
        else if op == o_import is
            hlpp_load::import_lib(vm, vm.p.lits[a], vm.p.lits[b])
            setx(vm, 0)
        else if op == o_fileimport is
            hlpp_load::file_import(vm, hlpp_vm::pop(vm), vm.p.lits[a], b)
        else if op == o_dirimport is
            hlpp_load::dir_import(vm, hlpp_vm::pop(vm))
        else if op == o_gobeg is
            let gn: string = vm.p.lits[a]
            let mut nm2: string = "<goroutine>"
            if string_len(gn) > 0 is nm2 = gn end
            hlpp_sys::err("\u{1b}[35m[hl :*]\u{1b}[0m goroutine '" + nm2 + "' uruchomiona\n")
            let mut forked: bool = false
            if hlpp_sys::can_fork() && !vm.win is
                let gp: int = hlpp_sys::fork_proc()
                if gp == 0 is
                    vm.is_child = true
                    forked = true
                else if gp > 0 is
                    vm.kids = array_push(vm.kids, gp)
                    vm.pc = b
                    forked = true
                end
            end
            if !forked is snapshot(vm) end
        else if op == o_goend is
            if vm.is_child is
                hlpp_sys::exit_now(0)
            end
            restore(vm)
            setx(vm, 0)
        else if op == o_chandecl is
            let cs: int = hlpp_vm::slot_of(vm, "__chan_" + vm.p.lits[a])
            hlpp_vm::set_var(vm, cs, "", 1)
            setx(vm, 0)
        else if op == o_chanop is
            hlpp_sys::outln(hlpp_vm::get_dyn(vm, "__chan_" + vm.p.lits[a]))
            setx(vm, 0)
        else if op == o_bg is
            let bcmd: string = string_trim(hlpp_vm::pop(vm))
            let bp: int = hlpp_sys::spawn_bg(bcmd, "sh")
            hlpp_vm::set_dyn(vm, "_bg_pid", to_string(bp), 2)
            hlpp_sys::err("\u{1b}[90m[hl &] PID=" + to_string(bp) + "\u{1b}[0m\n")
            setx(vm, 0)
        else if op == o_hsh is
            let hcmd: string = string_trim(hlpp_vm::pop(vm))
            if string_len(hlpp_sys::which_path("hsh")) == 0 is
                hlpp_vm::fail(vm, "hsh nie znaleziony: program 'hsh' nie jest w PATH")
            else is
                let hc: int = hlpp_sys::run_tty("hsh -c " + hlpp_sys::quote(hcmd))
                setx(vm, hc)
            end
        else if op == o_hos is
            let hr: int = hlpp_rt::run_hos(vm, vm.p.lits[a], hlpp_vm::pop(vm))
            setx(vm, hr)
        else if op == o_extern is
            let er: int = hlpp_rt::run_extern(vm, vm.p.lits[a], vm.p.lits[b])
            if vm.running is setx(vm, er) end
        else if op == o_varprint is
            hlpp_sys::outln(hlpp_vm::get_var(vm, a))
            setx(vm, 0)
        else if op == o_nop is
            if a == 1 is setx(vm, 0) end
        else if op == o_dyn_set is
            let dv: string = hlpp_vm::pop(vm)
            let dn: string = hlpp_vm::pop(vm)
            hlpp_vm::set_dyn(vm, dn, dv, 1)
        else if op == o_classdef is
            hlpp_oop::class_def(vm, vm.p.lits[a], vm.p.lits[b])
            setx(vm, 0)
        else if op == o_defmeth is
            hlpp_oop::method_def(vm, vm.p.lits[a], pc + 1, c)
            vm.pc = b
        else if op == o_fielddef is
            hlpp_oop::field_def(vm, vm.p.lits[a], vm.p.lits[b])
        else if op == o_new is
            op_new(vm, vm.p.lits[a], b, hlpp_vm::pop(vm))
        else if op == o_mcall is
            op_mcall(vm, pc, a, vm.p.lits[b], hlpp_vm::pop(vm))
        else if op == o_mret is
            let rs: int = hlpp_vm::special(vm, 1, "_ret")
            hlpp_vm::set_var(vm, a, hlpp_vm::get_var(vm, rs), 1)
            setx(vm, 0)
        else if op == o_setret is
            hlpp_vm::set_var(vm, hlpp_vm::special(vm, 1, "_ret"), hlpp_vm::pop(vm), 1)
        else if op == o_fget is
            let os: string = hlpp_vm::pop(vm)
            let oid: int = hlpp_vm::obj_id(os)
            if oid < 0 || !hlpp_oop::is_obj(vm, oid) is
                hlpp_vm::fail(vm, "Nie można odczytać pola '." + vm.p.lits[a] + "' — wartość '" + os + "' nie jest obiektem")
            else is
                hlpp_vm::push(vm, hlpp_oop::field_get(vm, oid, vm.p.lits[a]))
            end
        else if op == o_fset is
            let fv: string = hlpp_vm::pop(vm)
            let fid: int = obj_of_var(vm, a)
            if fid >= 0 is
                hlpp_oop::field_set(vm, fid, vm.p.lits[b], fv)
                setx(vm, 0)
            end
        else if op == o_delete is
            let did: int = obj_of_var(vm, a)
            if did >= 0 is
                hlpp_oop::free_object(vm, did)
                hlpp_vm::unset_var(vm, a)
                setx(vm, 0)
            end
        else if op == o_nfld is
            let nid: int = obj_of_var(vm, a)
            if nid >= 0 is
                let fnum: hlpp_num::Num = hlpp_num::parse(hlpp_oop::field_get(vm, nid, vm.p.lits[b]))
                if !fnum.ok is vm.nfail = true end
                hlpp_vm::npush(vm, fnum.m, fnum.s)
            end
        else if op == o_nendf is
            let eid: int = obj_of_var(vm, a)
            if eid >= 0 is
                hlpp_oop::field_set(vm, eid, vm.p.lits[b], hlpp_num::fmt(ntop(vm)))
                setx(vm, 0)
            end
        else if op == o_ashell is
            hlpp_vm::push(vm, hlpp_rt::arith_shell(vm, hlpp_vm::pop(vm)))
        else if op == o_exit is
            let ec: int = hlpp_text::int_or(string_trim(hlpp_vm::pop(vm)), 1)
            hlpp_rt::finish_exit(vm, ec)
        else if op == o_halt is
            vm.running = false
        end
    end
    hlpp_sys::flush_out()
    if !vm.is_child is
        let mut kk: int = 0
        while kk < array_len(vm.kids) is
            hlpp_sys::kill_proc(vm.kids[kk])
            kk += 1
        end
    end
end

pub fn main_libs_dir() -> string is
    return "/usr/lib/HackerOS/Hacker-Lang/main-libs"
end

pub fn bit_base_dir() -> string is
    let b: string = hlpp_sys::getenv("BIT_HOME")
    if string_len(b) > 0 is return b end
    return hlpp_sys::home() + "/.hackeros/libs"
end

fn colour_note(tag: string, col: string, msg: string) is
    hlpp_sys::err("\u{1b}[" + col + "m[hl " + tag + "]\u{1b}[0m " + msg + "\n")
end

;; compile `src` into the running program and enter it as a call frame; returns false on errors
pub fn enter_chunk(vm: hlpp_vm::VM, src: string, what: string) -> bool is
    return enter_chunk_k(vm, src, what, 3, "")
end

;; kind 4 = directory import: `saved` is the cwd restored when the frame returns
pub fn enter_chunk_k(vm: hlpp_vm::VM, src: string, what: string, kind: int, saved: string) -> bool is
    let p: hlpp_prog::Prog = vm.p
    let before: int = array_len(p.errs)
    let sv_ed: int = p.edition
    let sv_gen: int = p.gen
    let sv_cls: string = p.class_name
    let entry: int = hlpp_comp::compile_chunk(p, src, false)
    p.edition = sv_ed
    p.gen = sv_gen
    p.class_name = sv_cls
    if array_len(p.errs) > before is
        hlpp_vm::fail(vm, what + ": " + p.errs[before] + " (linia " + to_string(p.err_lines[before]) + ")")
        return false
    end
    hlpp_vm::ensure_slots(vm)
    hlpp_vm::ensure_code(vm)
    hlpp_vm::ensure_lits(vm)
    hlpp_vm::frame_push(vm, vm.pc, kind, saved, vm.obj_created)
    vm.pc = entry
    return true
end

fn read_source(path: string) -> string is
    return hlpp_sys::read(path)
end

pub fn file_import(vm: hlpp_vm::VM, path: string, detail: string, has: int) is
    let mut resolved: string = path
    if string_find(path, ".") < 0 is resolved = path + ".hl" end
    if !hlpp_sys::is_file(resolved) is
        hlpp_vm::fail(vm, "Import: plik nie istnieje: '" + resolved + "'")
        return
    end
    if has == 1 is hlpp_vm::set_dyn(vm, "_import_detail", detail, 1) end
    enter_chunk(vm, read_source(resolved), resolved)
end

pub fn dir_import(vm: hlpp_vm::VM, path: string) is
    if !hlpp_sys::exists(path) is
        hlpp_vm::fail(vm, "<* import: katalog nie istnieje: '" + path + "'")
        return
    end
    if !hlpp_sys::is_dir(path) is
        hlpp_vm::fail(vm, "<* import: '" + path + "' nie jest katalogiem (użyj << dla pliku)")
        return
    end
    let imp: string = path + "/imports.hl"
    if !hlpp_sys::is_file(imp) is
        hlpp_vm::fail(vm, "<* import: brak '" + imp + "' w katalogu '" + path + "'\n                Utwórz plik imports.hl z listą << plików do zaimportowania")
        return
    end
    hlpp_vm::set_dyn(vm, "_module_name", hlpp_text::basename(path), 1)
    ;; like hl: imports.hl runs with the module directory as cwd (restored when the frame returns)
    let saved: string = cwd()
    let mut abs: string = path
    if !hlpp_text::starts(path, "/") is abs = saved + "/" + path end
    hlpp_vm::set_dyn(vm, "_module_dir", abs, 1)
    hlpp_sys::chdir_to(abs)
    if !enter_chunk_k(vm, read_source(imp), imp, 4, saved) is
        hlpp_sys::chdir_to(saved)
    end
end

;; ── spec parsing ────────────────────────────────────────────────────────────
pub struct Spec is
    pub kind: int        ;; 0 none, 1 main, 2 bit, 3 github
    pub lib: string
    pub detail: string
    pub version: string
end

pub fn parse_spec(raw0: string) -> Spec is
    let raw: string = string_trim(raw0)
    let mut body: string = raw
    let mut version: string = ""
    let col: int = string_rfind(raw, ":")
    if col >= 0 is
        let after: string = string_slice(raw, col + 1, string_len(raw))
        if string_find(after, "/") < 0 is
            body = string_slice(raw, 0, col)
            version = after
        end
    end
    let sl: int = string_find(body, "/")
    if sl < 0 is return Spec { kind: 0, lib: "", detail: "", version: "" } end
    let ns: string = string_slice(body, 0, sl)
    let rest: string = string_slice(body, sl + 1, string_len(body))
    if ns == "main" || ns == "std" || ns == "core" is
        let s2: int = string_find(rest, "/")
        if s2 >= 0 is
            return Spec { kind: 1, lib: string_slice(rest, 0, s2), detail: string_slice(rest, s2 + 1, string_len(rest)), version: version }
        end
        return Spec { kind: 1, lib: rest, detail: "", version: version }
    end
    if ns == "bit" || ns == "virus" is return Spec { kind: 2, lib: rest, detail: "", version: version } end
    if ns == "github" || ns == "community" is return Spec { kind: 3, lib: rest, detail: "", version: version } end
    return Spec { kind: 0, lib: "", detail: "", version: "" }
end

;; ── builtin fallbacks (identical variables to hl's) ─────────────────────────
fn set_s(vm: hlpp_vm::VM, k: string, v: string) is
    hlpp_vm::set_dyn(vm, k, v, 1)
end

fn builtin_fallback(vm: hlpp_vm::VM, lib: string) -> bool is
    if lib == "net" is
        set_s(vm, "NET_LOCALHOST", "127.0.0.1")
        set_s(vm, "NET_BROADCAST", "255.255.255.255")
    else if lib == "fs" is
        set_s(vm, "FS_HOME", hlpp_sys::home())
        set_s(vm, "FS_TMP", hlpp_sys::temp_dir())
        set_s(vm, "FS_ETC", "/etc")
        set_s(vm, "FS_VAR_LOG", "/var/log")
    else if lib == "sys" is
        let ar: hlpp_sys::Res = hlpp_sys::run_shell("uname -m", vm.shell, true)
        set_s(vm, "SYS_ARCH", string_trim(ar.out))
        set_s(vm, "SYS_HOSTNAME", string_trim(hlpp_sys::read("/etc/hostname")))
    else if lib == "str" is
        set_s(vm, "STR_NEWLINE", "\n")
        set_s(vm, "STR_TAB", "\t")
    else if lib == "crypto" is
        set_s(vm, "CRYPTO_SHA256_CMD", "sha256sum")
        set_s(vm, "CRYPTO_MD5_CMD", "md5sum")
    else if lib == "proc" is
        let pd: int = hlpp_sys::pid()
        hlpp_vm::set_dyn(vm, "PROC_SELF_PID", to_string(pd), 2)
    else if lib == "colors" is
        set_s(vm, "COLOR_RED", "\u{1b}[31m")
        set_s(vm, "COLOR_GREEN", "\u{1b}[32m")
        set_s(vm, "COLOR_YELLOW", "\u{1b}[33m")
        set_s(vm, "COLOR_CYAN", "\u{1b}[36m")
        set_s(vm, "COLOR_RESET", "\u{1b}[0m")
        set_s(vm, "COLOR_BOLD", "\u{1b}[1m")
    else if lib == "cli" is
        let ac: int = array_len(vm.args) + 1
        hlpp_vm::set_dyn(vm, "CLI_ARGS_COUNT", to_string(ac), 2)
        set_s(vm, "CLI_PROG_NAME", "hlpp")
    else if lib == "progress-bar" is
        hlpp_vm::set_dyn(vm, "PROGRESS_BAR_LOADED", "true", 3)
    else if lib == "json" is
        hlpp_vm::set_dyn(vm, "JSON_LOADED", "true", 3)
    else if lib == "hk-parser" is
        hlpp_vm::set_dyn(vm, "HK_PARSER_LOADED", "true", 3)
        set_s(vm, "HK_PARSER_VERSION", "gen 1")
    else if lib == "hacker" is
        hlpp_vm::set_dyn(vm, "HACKER_PARSER_LOADED", "true", 3)
        set_s(vm, "HACKER_PARSER_VERSION", "gen 1")
    else is
        return false
    end
    colour_note("main", "36", "Zaladowano main/" + lib + " (builtin fallback)")
    return true
end

fn load_main(vm: hlpp_vm::VM, lib: string, detail: string) is
    ;; 1) system dir (HackerOS), 2) $HLPP_HOME/main-libs, 3) embedded copy, 4) builtin fallback
    let dirs: [string] = [main_libs_dir(), hlpp_sys::getenv("HLPP_HOME") + "/main-libs", hlpp_sys::home() + "/.hlpp/main-libs"]
    let mut i: int = 0
    while i < array_len(dirs) is
        let d: string = dirs[i]
        if string_len(d) > 10 is
            let f1: string = d + "/" + lib + ".hl"
            let f2: string = d + "/" + lib + "/lib.hl"
            let mut chosen: string = ""
            if hlpp_sys::is_file(f1) is chosen = f1 end
            if string_len(chosen) == 0 && hlpp_sys::is_file(f2) is chosen = f2 end
            if string_len(chosen) > 0 is
                if enter_chunk(vm, read_source(chosen), chosen) is
                    colour_note("main", "36", "Zaladowano main/" + lib)
                end
                return
            end
        end
        i += 1
    end
    let emb: string = hlpp_stdlib::source(lib)
    if string_len(emb) > 0 is
        if enter_chunk(vm, emb, "main/" + lib) is
            colour_note("main", "36", "Zaladowano main/" + lib + " (wbudowana)")
        end
        return
    end
    if builtin_fallback(vm, lib) is return end
    hlpp_vm::fail(vm, "Biblioteka main/" + lib + " nie znaleziona w " + main_libs_dir() + " i brak wbudowanego fallbacku")
end

fn upper_ident(name: string) -> string is
    return string_replace_all(hlpp_text::up(name), "-", "_")
end

fn load_bit(vm: hlpp_vm::VM, name: string) is
    let cur: string = bit_base_dir() + "/" + name + "/current"
    if !hlpp_sys::is_dir(cur) is
        hlpp_vm::fail(vm, "Biblioteka bit '" + name + "' nie jest zainstalowana.\n\nAby zainstalować:\n\u{1b}[32m  bit install " + name + "\u{1b}[0m\n\nJeśli pakiet nie istnieje w repozytorium:\n\u{1b}[32m  bit search " + name + "\u{1b}[0m")
        return
    end
    let cands: [string] = [cur + "/lib.hl", cur + "/" + name + ".hl", cur + "/main.hl", cur + "/mod.hl"]
    let pre: string = upper_ident(name)
    let mut i: int = 0
    while i < array_len(cands) is
        if hlpp_sys::is_file(cands[i]) is
            hlpp_vm::set_dyn(vm, "BIT_" + pre + "_LOADED", "true", 3)
            hlpp_vm::set_dyn(vm, "BIT_" + pre + "_PATH", cur, 1)
            if enter_chunk(vm, read_source(cands[i]), cands[i]) is
                colour_note("bit", "35", "Zaladowano bit/" + name)
            end
            return
        end
        i += 1
    end
    ;; Hacker Lang++ extension: packages that ship an `.hlib` (bit.io's official API)
    let hl: string = hlpp_hlib::find_hlib(cur, name)
    if string_len(hl) > 0 is
        hlpp_vm::set_dyn(vm, "BIT_" + pre + "_LOADED", "true", 3)
        hlpp_vm::set_dyn(vm, "BIT_" + pre + "_PATH", cur, 1)
        let src: string = hlpp_hlib::hl_source(vm, hl, name)
        if string_len(src) > 0 is
            if enter_chunk(vm, src, hl) is
                colour_note("bit", "35", "Zaladowano bit/" + name + " (.hlib)")
            end
            return
        end
        if string_len(vm.err) > 0 is return end
    end
    let so: string = cur + "/" + name + ".so"
    if hlpp_sys::is_file(so) is
        hlpp_vm::set_dyn(vm, "BIT_" + pre + "_LOADED", "true", 3)
        hlpp_vm::set_dyn(vm, "BIT_" + pre + "_PATH", so, 1)
        colour_note("bit", "35", "Zaladowano bit/" + name + " (.so)")
        return
    end
    hlpp_vm::fail(vm, "Biblioteka bit '" + name + "' zainstalowana w " + cur + " ale brak pliku lib.hl/" + name + ".hl/main.hl/" + name + ".so/.hlib\nSpróbuj: bit upgrade " + name)
end

fn load_github(vm: hlpp_vm::VM, path: string, version: string) is
    let dir: string = hlpp_sys::home() + "/.hl/libs/github/" + string_replace_all(path, "/", "__")
    if !hlpp_sys::is_dir(dir) is
        if string_len(hlpp_sys::which_path("git")) == 0 is
            hlpp_vm::fail(vm, "git nie jest zainstalowany")
            return
        end
        hlpp_sys::mkdir_p(dir)
        let mut cmd: string = "git clone --depth=1"
        if string_len(version) > 0 is cmd = cmd + " --branch " + hlpp_sys::quote(version) end
        cmd = cmd + " https://github.com/" + path + ".git " + hlpp_sys::quote(dir)
        let r: hlpp_sys::Res = hlpp_sys::run_shell(cmd, vm.shell, false)
        if r.code != 0 is
            hlpp_vm::fail(vm, "Nie mozna pobrac github: " + path)
            return
        end
    end
    let names: [string] = ["lib.hl", "mod.hl", "main.hl"]
    let mut i: int = 0
    while i < array_len(names) is
        let f: string = dir + "/" + names[i]
        if hlpp_sys::is_file(f) is
            enter_chunk(vm, read_source(f), f)
            return
        end
        i += 1
    end
    hlpp_vm::fail(vm, "Brak pliku wejsciowego dla '" + path + "' w " + dir)
end

pub fn import_lib(vm: hlpp_vm::VM, lib0: string, detail: string) is
    let mut lib: string = string_trim(lib0)
    if string_starts_with(lib, "<") && string_ends_with(lib, ">") is
        lib = string_slice(lib, 1, string_len(lib) - 1)
    end
    let sp: Spec = parse_spec(lib)
    if sp.kind == 1 is
        load_main(vm, sp.lib, sp.detail)
        return
    end
    if sp.kind == 2 is
        load_bit(vm, sp.lib)
        return
    end
    if sp.kind == 3 is
        load_github(vm, sp.lib, sp.version)
        return
    end
    let names: [string] = ["net", "fs", "sys", "str", "crypto", "proc"]
    let mut i: int = 0
    while i < array_len(names) is
        if lib == "std/" + names[i] || lib == "main/" + names[i] is
            load_main(vm, names[i], detail)
            return
        end
        i += 1
    end
    hlpp_vm::fail(vm, "Nieznana biblioteka: '" + lib + "'")
end

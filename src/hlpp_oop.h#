mod hlpp_text
mod hlpp_map
mod hlpp_prog
mod hlpp_vm

pub fn find_class(vm: hlpp_vm::VM, name: string) -> int is
    return hlpp_map::get(vm.cls, name, 0 - 1)
end

pub fn class_def(vm: hlpp_vm::VM, name: string, parent: string) is
    let mut pid: int = 0 - 1
    if string_len(parent) > 0 is
        pid = find_class(vm, parent)
        if pid < 0 is
            hlpp_vm::fail(vm, "Klasa '" + name + "' dziedziczy po nieznanej klasie '" + parent + "'")
            return
        end
    end
    let cid: int = array_len(vm.cls_name)
    vm.cls_name = array_push(vm.cls_name, name)
    vm.cls_parent = array_push(vm.cls_parent, pid)
    vm.cls_fields = array_push(vm.cls_fields, "")
    hlpp_map::put(vm.cls, name, cid)
    vm.cur_cls = cid
end

pub fn field_def(vm: hlpp_vm::VM, name: string, dflt: string) is
    if vm.cur_cls < 0 is return end
    let c: int = vm.cur_cls
    vm.cls_fields[c] = vm.cls_fields[c] + "\u{1}" + name + "\u{2}" + dflt
end

pub fn method_def(vm: hlpp_vm::VM, name: string, pc: int, params: int) is
    if vm.cur_cls < 0 is return end
    let key: string = to_string(vm.cur_cls) + ":" + name
    hlpp_map::put(vm.meth, key, pc)
    hlpp_map::put(vm.meth_par, key, params)
end

;; method lookup through the inheritance chain; returns pc or -1 and sets owner via out param array
pub fn find_method(vm: hlpp_vm::VM, cid: int, name: string) -> int is
    let mut c: int = cid
    while c >= 0 is
        let key: string = to_string(c) + ":" + name
        let at: int = hlpp_map::find(vm.meth, key)
        if at >= 0 is return vm.meth.vals[at] end
        c = vm.cls_parent[c]
    end
    return 0 - 1
end

pub fn method_params(vm: hlpp_vm::VM, cid: int, name: string) -> string is
    let mut c: int = cid
    while c >= 0 is
        let key: string = to_string(c) + ":" + name
        let at: int = hlpp_map::find(vm.meth_par, key)
        if at >= 0 is return vm.p.lits[vm.meth_par.vals[at]] end
        c = vm.cls_parent[c]
    end
    return ""
end

pub fn is_obj(vm: hlpp_vm::VM, id: int) -> bool is
    if id < 0 || id >= array_len(vm.obj_live) is return false end
    return vm.obj_live[id] == 1
end

fn fkey(id: int, f: string) -> string is
    return to_string(id) + "." + f
end

pub fn field_set(vm: hlpp_vm::VM, id: int, f: string, v: string) is
    let k: string = fkey(id, f)
    let at: int = hlpp_map::find(vm.ofields, k)
    if at >= 0 is
        vm.ofv[vm.ofields.vals[at]] = v
        return
    end
    let mut idx: int = 0
    if array_len(vm.ofv_free) > 0 is
        idx = vm.ofv_free[array_len(vm.ofv_free) - 1]
        vm.ofv_free = array_pop(vm.ofv_free)
        vm.ofv[idx] = v
    else is
        idx = array_len(vm.ofv)
        vm.ofv = array_push(vm.ofv, v)
    end
    hlpp_map::put(vm.ofields, k, idx)
    vm.obj_fnames[id] = vm.obj_fnames[id] + "\u{1}" + f
end

pub fn field_get(vm: hlpp_vm::VM, id: int, f: string) -> string is
    let at: int = hlpp_map::find(vm.ofields, fkey(id, f))
    if at < 0 is return "" end
    return vm.ofv[vm.ofields.vals[at]]
end

pub fn field_has(vm: hlpp_vm::VM, id: int, f: string) -> bool is
    return hlpp_map::find(vm.ofields, fkey(id, f)) >= 0
end

fn init_fields(vm: hlpp_vm::VM, id: int, cid: int) is
    if cid < 0 is return end
    init_fields(vm, id, vm.cls_parent[cid])
    let ents: [string] = hlpp_text::words_by(vm.cls_fields[cid], "\u{1}")
    let mut i: int = 0
    while i < array_len(ents) is
        let e: string = ents[i]
        let at: int = string_find(e, "\u{2}")
        if at >= 0 is
            field_set(vm, id, string_slice(e, 0, at), string_slice(e, at + 1, string_len(e)))
        end
        i += 1
    end
end

pub fn new_object(vm: hlpp_vm::VM, cid: int) -> int is
    let mut id: int = 0
    if vm.obj_nfree > 0 is
        id = vm.obj_free[vm.obj_nfree - 1]
        vm.obj_nfree -= 1
        vm.obj_cls[id] = cid
        vm.obj_live[id] = 1
        vm.obj_fnames[id] = ""
        vm.obj_seq[id] = vm.obj_created
    else is
        id = array_len(vm.obj_cls)
        vm.obj_cls = array_push(vm.obj_cls, cid)
        vm.obj_live = array_push(vm.obj_live, 1)
        vm.obj_fnames = array_push(vm.obj_fnames, "")
        vm.obj_seq = array_push(vm.obj_seq, vm.obj_created)
    end
    vm.obj_created += 1
    init_fields(vm, id, cid)
    return id
end

pub fn free_object(vm: hlpp_vm::VM, id: int) is
    if !is_obj(vm, id) is return end
    let names: [string] = hlpp_text::words_by(vm.obj_fnames[id], "\u{1}")
    let mut i: int = 0
    while i < array_len(names) is
        let k: string = fkey(id, names[i])
        let at: int = hlpp_map::find(vm.ofields, k)
        if at >= 0 is
            let idx: int = vm.ofields.vals[at]
            vm.ofv[idx] = ""
            vm.ofv_free = array_push(vm.ofv_free, idx)
            hlpp_map::remove(vm.ofields, k)
        end
        i += 1
    end
    vm.obj_live[id] = 0
    vm.obj_fnames[id] = ""
    if vm.obj_nfree < array_len(vm.obj_free) is
        vm.obj_free[vm.obj_nfree] = id
    else is
        vm.obj_free = array_push(vm.obj_free, id)
    end
    vm.obj_nfree += 1
end

pub fn live_count(vm: hlpp_vm::VM) -> int is
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(vm.obj_live) is
        n += vm.obj_live[i]
        i += 1
    end
    return n
end

;; Region release: objects created since `mark` (creation counter) that are not reachable from any
;; variable are freed. Reachability: variable values equal to "<obj:N>", followed through fields.
pub fn release_region(vm: hlpp_vm::VM, mark: int) is
    let total: int = array_len(vm.obj_live)
    if vm.obj_created <= mark is return end
    let mut reach: [int] = []
    let mut i: int = 0
    while i < total is
        reach = array_push(reach, 0)
        i += 1
    end
    let mut work: [int] = []
    let mut s: int = 0
    while s < array_len(vm.vals) is
        if vm.vt[s] != 0 is
            let id: int = hlpp_vm::obj_id(vm.vals[s])
            if id >= 0 && id < total && reach[id] == 0 && vm.obj_live[id] == 1 is
                reach[id] = 1
                work = array_push(work, id)
            end
        end
        s += 1
    end
    ;; objects held on the operand/return stacks (self of active frames)
    let mut r: int = 0
    while r < vm.rsp is
        let id2: int = hlpp_vm::obj_id(vm.rself[r])
        if id2 >= 0 && id2 < total && reach[id2] == 0 && vm.obj_live[id2] == 1 is
            reach[id2] = 1
            work = array_push(work, id2)
        end
        r += 1
    end
    while array_len(work) > 0 is
        let cur: int = work[array_len(work) - 1]
        work = array_pop(work)
        let names: [string] = hlpp_text::words_by(vm.obj_fnames[cur], "\u{1}")
        let mut k: int = 0
        while k < array_len(names) is
            let child: int = hlpp_vm::obj_id(field_get(vm, cur, names[k]))
            if child >= 0 && child < total && reach[child] == 0 && vm.obj_live[child] == 1 is
                reach[child] = 1
                work = array_push(work, child)
            end
            k += 1
        end
    end
    let mut o: int = 0
    while o < total is
        if vm.obj_live[o] == 1 && reach[o] == 0 && vm.obj_seq[o] >= mark is free_object(vm, o) end
        o += 1
    end
end

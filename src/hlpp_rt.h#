fn test_unary(flag: string, v: string) -> int is
    if flag == "-n" is return code_of(string_len(v) > 0) end
    if flag == "-z" is return code_of(string_len(v) == 0) end
    if flag == "-e" is return code_of(hlpp_sys::exists(v)) end
    if flag == "-f" is return code_of(hlpp_sys::is_file(v)) end
    if flag == "-d" is return code_of(hlpp_sys::is_dir(v)) end
    if flag == "-s" is return code_of(hlpp_sys::is_file(v) && string_len(hlpp_sys::read(v)) > 0) end
    if flag == "-r" || flag == "-x" || flag == "-L" || flag == "-h" is return 99 end
    return 98
end

fn ncmp(a: string, b: string, op: string) -> int is
    let x: hlpp_num::Num = hlpp_num::val_or0(string_trim(a))
    let y: hlpp_num::Num = hlpp_num::val_or0(string_trim(b))
    let c: int = hlpp_num::cmp(x, y)
    if op == "-eq" is return code_of(c == 0) end
    if op == "-ne" is return code_of(c != 0) end
    if op == "-lt" is return code_of(c < 0) end
    if op == "-le" is return code_of(c <= 0) end
    if op == "-gt" is return code_of(c > 0) end
    return code_of(c >= 0)
end

;; builtin `test` / `[ ]`: returns -1 when not handled (falls through to the system)
fn try_test(cmd: string) -> int is
    let mut s: string = cmd
    if string_starts_with(s, "[ ") && string_ends_with(s, " ]") is
        s = string_trim(string_slice(s, 2, string_len(s) - 2))
    else if string_starts_with(s, "test ") || s == "test" is
        s = string_trim(string_slice(s, 4, string_len(s)))
    else is
        return 0 - 1
    end
    let t: [string] = hlpp_text::shell_words(s)
    let n: int = array_len(t)
    if n == 2 is
        let r: int = test_unary(t[0], t[1])
        if r >= 98 is return 0 - 1 end
        return r
    end
    if n == 1 is
        if t[0] == "-n" || t[0] == "-z" || string_len(t[0]) == 0 is return 1 end
        return 0
    end
    if n == 3 is
        let op: string = t[1]
        if op == "=" || op == "==" is return code_of(t[0] == t[2]) end
        if op == "!=" is return code_of(t[0] != t[2]) end
        if op == "-eq" || op == "-ne" || op == "-lt" || op == "-le" || op == "-gt" || op == "-ge" is return ncmp(t[0], t[2], op) end
    end
    return 0 - 1
end

fn needs_shell(cmd: string) -> bool is
    let b: [int] = string_to_bytes(cmd)
    let n: int = array_len(b)
    let mut i: int = 0
    while i < n is
        let c: int = b[i]
        if c == 38 || c == 59 || c == 96 is return true end
        if c == 124 && i + 1 < n && b[i + 1] != 62 is return true end
        if c == 62 && i + 1 < n && (b[i + 1] == 62 || b[i + 1] == 32) is return true end
        if c == 60 && i + 1 < n && b[i + 1] == 32 is return true end
        if c == 36 && i + 1 < n && b[i + 1] == 40 is return true end
        if c == 42 && i + 2 < n && b[i + 1] != 47 is return true end
        i += 1
    end
    if string_find(cmd, "$HOME") >= 0 || string_find(cmd, "$USER") >= 0 || string_find(cmd, "$PATH") >= 0 is return true end
    if string_find(cmd, "$1") >= 0 || string_find(cmd, "${") >= 0 is return true end
    return false
end

pub fn finish_exit(vm: hlpp_vm::VM, code: int) is
    vm.running = false
    vm.exit_code = code
end

;; run one command line with hl semantics. mode: 0 plain 1 sudo 2 isolated 3 isolated+sudo (4..6 same + vars)
pub fn run_command(vm: hlpp_vm::VM, raw: string, mode: int, capture: bool) -> hlpp_sys::Res is
    let cmd: string = string_trim(raw)
    let none: hlpp_sys::Res = hlpp_sys::Res { code: 0, out: "" }
    if cmd == "exit" is
        finish_exit(vm, 0)
        return none
    end
    if string_starts_with(cmd, "exit ") is
        let ec: int = hlpp_text::int_or(string_trim(string_slice(cmd, 5, string_len(cmd))), 1)
        finish_exit(vm, ec)
        return none
    end
    let tr: int = try_test(cmd)
    if tr >= 0 is return hlpp_sys::Res { code: tr, out: "" } end
    if cmd == "cd" || string_starts_with(cmd, "cd ") is
        let tgt: string = string_trim(string_slice(cmd, 2, string_len(cmd)))
        let mut dest: string = tgt
        if string_len(tgt) == 0 is dest = hlpp_sys::home() end
        if !needs_shell(cmd) is
            if hlpp_sys::chdir_to(dest) is return none end
            hlpp_vm::fail(vm, "cd: nie można przejść do '" + dest + "'")
            return hlpp_sys::Res { code: 1, out: "" }
        end
    end
    let mut sudo: bool = false
    let mut iso: bool = false
    if mode == 1 || mode == 3 || mode == 5 is sudo = true end
    if mode == 2 || mode == 3 || mode == 6 is iso = true end
    let sh: string = vm.shell
    let win: bool = vm.win
    let mut line: string = cmd
    if needs_shell(cmd) is
        let bq: string = hlpp_text::shq(cmd, false)
        if iso && sudo is
            line = "sudo unshare --mount --pid --net --fork -- bash -c " + bq
        else if iso is
            line = "unshare --mount --pid --net --fork -- bash -c " + bq
        else if sudo is
            line = "sudo bash -c " + bq
        end
    else is
        let ws: [string] = hlpp_text::shell_words(cmd)
        if array_len(ws) == 0 is return none end
        let prog: string = ws[0]
        if !sudo && !iso && string_find(prog, "/") < 0 && string_len(hlpp_sys::which_path(prog)) == 0 is
            hlpp_vm::fail(vm, "nie udało się uruchomić komendy '" + cmd + "' — program '" + prog + "' nie znaleziony w PATH albo brak uprawnień do jego uruchomienia. Sprawdź, czy jest zainstalowany (`which " + prog + "`) i czy ścieżka do niego jest w $PATH tego procesu.")
            return hlpp_sys::Res { code: 127, out: "" }
        end
        let mut q: string = ""
        let mut i: int = 0
        while i < array_len(ws) is
            if i > 0 is q = q + " " end
            q = q + hlpp_text::shq(ws[i], win)
            i += 1
        end
        line = q
        if iso is line = "unshare --mount --pid --net --fork -- " + q end
        if sudo is line = "sudo " + line end
    end
    return hlpp_sys::run_shell(line, sh, capture)
end


pub struct QR is
    pub known: bool
    pub out: string
    pub code: int
    pub raw: bool        ;; true: print without trailing newline
end

fn qr(out: string) -> QR is
    return QR { known: true, out: out, code: 0, raw: false }
end

fn qrc(out: string, code: int) -> QR is
    return QR { known: true, out: out, code: code, raw: false }
end

fn b2s(b: bool) -> string is
    if b is return "true" end
    return "false"
end

fn code_of(b: bool) -> int is
    if b is return 0 end
    return 1
end

fn pnum(s: string) -> hlpp_num::Num is
    return hlpp_num::val_or0(string_trim(s))
end

;; string reverse by code points
fn rev_str(s: string) -> string is
    let c128: int = 128
    let c192: int = 192
    let n: int = string_len(s)
    let mut r: string = ""
    let mut i: int = n
    while i > 0 is
        let mut j: int = i - 1
        ;; step back over UTF-8 continuation bytes
        let bs: [int] = string_to_bytes(s)
        while j > 0 && bs[j] >= c128 && bs[j] < c192 is j -= 1 end
        r = r + string_slice(s, j, i)
        i = j
    end
    return r
end

fn rev_str_fast(s: string) -> string is
    let c128: int = 128
    let c192: int = 192
    let bs: [int] = string_to_bytes(s)
    let n: int = array_len(bs)
    let mut r: string = ""
    let mut i: int = n
    while i > 0 is
        let mut j: int = i - 1
        while j > 0 && bs[j] >= c128 && bs[j] < c192 is j -= 1 end
        r = r + string_slice(s, j, i)
        i = j
    end
    return r
end

fn split_lines(s: string) -> [string] is
    let mut out: [string] = []
    let mut st: int = 0
    let n: int = string_len(s)
    let bs: [int] = string_to_bytes(s)
    let mut i: int = 0
    while i < n is
        if bs[i] == 10 is
            let mut e: int = i
            if e > st && bs[e - 1] == 13 is e -= 1 end
            out = array_push(out, string_slice(s, st, e))
            st = i + 1
        end
        i += 1
    end
    if st < n is out = array_push(out, string_slice(s, st, n)) end
    return out
end

fn split_by(s: string, sep: string) -> [string] is
    let mut out: [string] = []
    let sl: int = string_len(sep)
    if sl == 0 is
        return [s]
    end
    let mut from: int = 0
    while true is
        let rest: string = string_slice(s, from, string_len(s))
        let k: int = string_find(rest, sep)
        if k < 0 is
            out = array_push(out, rest)
            break
        end
        out = array_push(out, string_slice(rest, 0, k))
        from = from + k + sl
    end
    return out
end

fn today_fmt(fmt: string) -> string is
    let r: hlpp_sys::Res = hlpp_sys::run_shell("date +" + fmt, hlpp_sys::shell_program(), true)
    return string_trim(r.out)
end

;; Evaluate a quick function without printing. Needs the VM for set/get/type/unset.
pub fn quick_eval(vm: hlpp_vm::VM, name: string, raw_arg: string) -> QR is
    let a: string = string_trim(raw_arg)
    if name == "upper" is return qr(hlpp_text::up(a)) end
    if name == "lower" is return qr(hlpp_text::low(a)) end
    if name == "len" is
        let l: int = string_len(a)
        return qr(to_string(l))
    end
    if name == "trim" is return qr(a) end
    if name == "rev" is return qr(rev_str_fast(a)) end
    if name == "repeat" is
        let sp: [string] = hlpp_text::split_last(a)
        let n: int = hlpp_text::int_or(sp[1], 1)
        return qr(hlpp_text::repeat_str(sp[0], n))
    end
    if name == "replace" is
        let ws: [string] = hlpp_text::words(a)
        ;; splitn(3, ' ') semantics
        let f1: int = string_find(a, " ")
        if f1 < 0 is
            hlpp_vm::fail(vm, ":: replace wymaga: :: replace <text> <from> <to>")
            return QR { known: true, out: "", code: 1, raw: false }
        end
        let rest: string = string_slice(a, f1 + 1, string_len(a))
        let f2: int = string_find(rest, " ")
        if f2 < 0 is
            hlpp_vm::fail(vm, ":: replace wymaga: :: replace <text> <from> <to>")
            return QR { known: true, out: "", code: 1, raw: false }
        end
        let text: string = string_slice(a, 0, f1)
        let from: string = string_slice(rest, 0, f2)
        let to: string = string_slice(rest, f2 + 1, string_len(rest))
        return qr(string_replace_all(text, from, to))
    end
    if name == "contains" || name == "startswith" || name == "endswith" is
        let sp: [string] = hlpp_text::split_last(a)
        let mut r: bool = false
        if name == "contains" is r = string_find(sp[0], sp[1]) >= 0 end
        if name == "startswith" is r = string_starts_with(sp[0], sp[1]) end
        if name == "endswith" is r = string_ends_with(sp[0], sp[1]) end
        hlpp_vm::set_dyn(vm, "_last_bool", b2s(r), 3)
        return qrc(b2s(r), code_of(r))
    end
    if name == "split" is
        let sp: [string] = hlpp_text::split_last(a)
        return qr(hlpp_text::join(split_by(sp[0], sp[1]), "\n"))
    end
    if name == "lines" is return qr(hlpp_text::join(split_lines(a), "\n")) end
    if name == "words" is return qr(hlpp_text::join(hlpp_text::words(a), "\n")) end
    if name == "abs" is return qr(hlpp_num::fmt(hlpp_num::abs(pnum(a)))) end
    if name == "ceil" is
        let v: int = hlpp_num::ceil_i(pnum(a))
        return qr(to_string(v))
    end
    if name == "floor" is
        let v: int = hlpp_num::floor_i(pnum(a))
        return qr(to_string(v))
    end
    if name == "round" is
        let v: int = hlpp_num::round_i(pnum(a))
        return qr(to_string(v))
    end
    if name == "max" || name == "min" is
        let sp: [string] = hlpp_text::split_last(a)
        let x: hlpp_num::Num = pnum(sp[0])
        let y: hlpp_num::Num = pnum(sp[1])
        let c: int = hlpp_num::cmp(x, y)
        if name == "max" is
            if c > 0 is return qr(hlpp_num::fmt(x)) end
            return qr(hlpp_num::fmt(y))
        end
        if c < 0 is return qr(hlpp_num::fmt(x)) end
        return qr(hlpp_num::fmt(y))
    end
    if name == "rand" is
        let t: int = hlpp_sys::now_ms()
        let mut x: int = (t * 1103515245 + 12345) % 2147483648
        if x < 0 is x = 0 - x end
        let r: int = x % 100
        return qr(to_string(r))
    end
    if name == "env" is
        let has: bool = hlpp_sys::has_env(a)
        return qrc(hlpp_sys::getenv(a), code_of(has))
    end
    if name == "getenv" is
        let has2: bool = hlpp_sys::has_env(a)
        let mut q: QR = qrc(hlpp_sys::getenv(a), code_of(has2))
        q.raw = true
        return q
    end
    if name == "env-path" is
        let ap: string = hlpp_sys::getenv("HL_ACTIVE_ENV_PATH")
        return qrc(ap, code_of(string_len(ap) > 0))
    end
    if name == "date" is return qr(today_fmt("%Y-%m-%d")) end
    if name == "time" is return qr(today_fmt("%H:%M:%S")) end
    if name == "pid" is
        let pd: int = hlpp_sys::pid()
        return qr(to_string(pd))
    end
    if name == "which" is
        let w: string = hlpp_sys::which_path(a)
        return qrc(w, code_of(string_len(w) > 0))
    end
    if name == "exists" || name == "isdir" || name == "isfile" is
        let mut e: bool = hlpp_sys::exists(a)
        if name == "isdir" is e = hlpp_sys::is_dir(a) end
        if name == "isfile" is e = hlpp_sys::is_file(a) end
        hlpp_vm::set_dyn(vm, "_last_bool", b2s(e), 3)
        let mut q2: QR = qrc("", code_of(e))
        q2.raw = true
        return q2
    end
    if name == "basename" is return qr(hlpp_text::basename(a)) end
    if name == "dirname" is return qr(hlpp_text::dirname(a)) end
    if name == "read" is
        if !hlpp_sys::is_file(a) is
            hlpp_vm::fail(vm, ":: read '" + a + "': nie można odczytać pliku")
            return QR { known: true, out: "", code: 1, raw: true }
        end
        let mut q3: QR = qr(hlpp_sys::read(a))
        q3.raw = true
        return q3
    end
    if name == "set" is
        let f: int = string_find(a, " ")
        if f < 0 is
            hlpp_vm::set_dyn(vm, a, "", 1)
        else is
            hlpp_vm::set_dyn(vm, string_trim(string_slice(a, 0, f)), string_trim(string_slice(a, f + 1, string_len(a))), 1)
        end
        let mut q4: QR = qr("")
        q4.raw = true
        return q4
    end
    if name == "get" is return qr(hlpp_vm::get_dyn(vm, a)) end
    if name == "type" is
        let s: int = hlpp_vm::find_slot(vm, a)
        if s < 0 is return qr("nil") end
        let t: int = vm.vt[s]
        return qr(hlpp_vm::type_name(t))
    end
    if name == "unset" is
        let s2: int = hlpp_vm::find_slot(vm, a)
        if s2 >= 0 is hlpp_vm::unset_var(vm, s2) end
        let mut q5: QR = qr("")
        q5.raw = true
        return q5
    end
    if name == "nl" is return qr("") end
    if name == "hr" is
        let w2: int = hlpp_text::int_or(a, 60)
        return qr(hlpp_text::repeat_str("─", w2))
    end
    if name == "bold" is return qr("\u{1b}[1m" + a + "\u{1b}[0m") end
    if name == "red" is return qr("\u{1b}[31m" + a + "\u{1b}[0m") end
    if name == "green" is return qr("\u{1b}[32m" + a + "\u{1b}[0m") end
    if name == "yellow" is return qr("\u{1b}[33m" + a + "\u{1b}[0m") end
    if name == "cyan" is return qr("\u{1b}[36m" + a + "\u{1b}[0m") end
    return QR { known: false, out: "", code: 1, raw: false }
end


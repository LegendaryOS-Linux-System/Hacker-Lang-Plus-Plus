pub fn source(name: string) -> string is
    if name == "cli" is return ";;; main/cli.hl — Argumenty i konfiguracja CLI\n;;; /usr/lib/HackerOS/Hacker-Lang/main-libs/cli.hl\nusing <gen 2>\n\n% CLI_ARGC    = @argc\n% CLI_ARG0    = @arg0\n% CLI_ARG1    = @arg1\n% CLI_ARG2    = @arg2\n% CLI_ARG3    = @arg3\n\n> echo \"$0\" |> @CLI_PROG_PATH\n::basename @CLI_PROG_PATH\n;; Pobierz nazwe programu do zmiennej przez pipe\n> basename \"@CLI_PROG_PATH\" |> @CLI_PROG\n\n% CLI_NO_COLOR = false\n% CLI_VERBOSE  = false\n% CLI_DEBUG    = false\n% CLI_QUIET    = false\n\n;; Sprawdz flagi srodowiskowe\n> test \"$\u{7b\u{7d}NO_COLOR:-\u{7d}\" = \"1\"\n? ok\n    % CLI_NO_COLOR = true\ndone\n\n> test \"$\u{7b\u{7d}VERBOSE:-\u{7d}\" = \"1\"\n? ok\n    % CLI_VERBOSE = true\ndone\n\n> test \"$\u{7b\u{7d}DEBUG:-\u{7d}\" = \"1\"\n? ok\n    % CLI_DEBUG = true\ndone\n\n;; Uzycie: % _cli_flag = --verbose && -- cli_has_flag\n: cli_has_flag def\n    >> bash -c \"\n        for arg in \\\"\\$@\\\"; do\n            [ \\\"\\$arg\\\" = '@_cli_flag' ] && exit 0\n        done\n        exit 1\n    \" -- @arg0 @arg1 @arg2 @arg3\ndone\n\n;; Pobierz wartosc opcji: --output=wartosc lub --output wartosc\n: cli_get_opt def\n    ;; % _cli_opt = --output && -- cli_get_opt → @_cli_opt_val\n    >> bash -c \"\n        for arg in \\\"\\$@\\\"; do\n            case \\\"\\$arg\\\" in\n                @_cli_opt=*) printf '%s' \\\"\\$\u{7b\u{7d}arg#*=\u{7d}\\\"; exit 0 ;;\n            esac\n        done\n        exit 1\n    \" -- @arg0 @arg1 @arg2 @arg3 |> @_cli_opt_val\ndone\n\n;; Wyswietl uzycie\n: cli_usage def\n    ;; % _cli_usage_text = \"uzycie: ...\" && -- cli_usage\n    ~> Uzycie: @_cli_usage_text\n    > exit 1\ndone\n" end
    if name == "colors" is return ";;; main/colors.hl — Kolory ANSI\n;;; /usr/lib/HackerOS/Hacker-Lang/main-libs/colors.hl\nusing <gen 2>\n\n;; Tekst\n% COLOR_RED           = \\033[31m\n% COLOR_GREEN         = \\033[32m\n% COLOR_YELLOW        = \\033[33m\n% COLOR_BLUE          = \\033[34m\n% COLOR_MAGENTA       = \\033[35m\n% COLOR_CYAN          = \\033[36m\n% COLOR_WHITE         = \\033[37m\n% COLOR_RESET         = \\033[0m\n% COLOR_BOLD          = \\033[1m\n% COLOR_DIM           = \\033[2m\n% COLOR_ITALIC        = \\033[3m\n% COLOR_UNDERLINE     = \\033[4m\n\n;; Jasne warianty\n% COLOR_BRIGHT_RED    = \\033[91m\n% COLOR_BRIGHT_GREEN  = \\033[92m\n% COLOR_BRIGHT_YELLOW = \\033[93m\n% COLOR_BRIGHT_BLUE   = \\033[94m\n% COLOR_BRIGHT_CYAN   = \\033[96m\n% COLOR_BRIGHT_WHITE  = \\033[97m\n\n;; Tlo\n% BG_RED     = \\033[41m\n% BG_GREEN   = \\033[42m\n% BG_YELLOW  = \\033[43m\n% BG_BLUE    = \\033[44m\n% BG_MAGENTA = \\033[45m\n% BG_CYAN    = \\033[46m\n% BG_WHITE   = \\033[47m\n\n;; Aliasy krotkie\n% C_R  = \\033[31m\n% C_G  = \\033[32m\n% C_Y  = \\033[33m\n% C_B  = \\033[34m\n% C_M  = \\033[35m\n% C_C  = \\033[36m\n% C_0  = \\033[0m\n% C_BD = \\033[1m\n" end
    if name == "crypto" is return ";;; main/crypto.hl — Kryptografia\n;;; /usr/lib/HackerOS/Hacker-Lang/main-libs/crypto.hl\nusing <gen 2>\n\n% CRYPTO_SHA256_CMD = sha256sum\n% CRYPTO_MD5_CMD    = md5sum\n% CRYPTO_SHA1_CMD   = sha1sum\n% CRYPTO_SHA512_CMD = sha512sum\n\n;; SHA256 pliku lub stringa\n: crypto_sha256_file def\n    ;; % _crypto_file = /sciezka && -- crypto_sha256_file → @_crypto_hash\n    >> sha256sum @_crypto_file | cut -d' ' -f1 |> @_crypto_hash\ndone\n\n: crypto_sha256_str def\n    ;; % _crypto_str = tekst && -- crypto_sha256_str → @_crypto_hash\n    >> bash -c \"printf '%s' '@_crypto_str' | sha256sum | cut -d' ' -f1\" |> @_crypto_hash\ndone\n\n: crypto_md5_file def\n    >> md5sum @_crypto_file | cut -d' ' -f1 |> @_crypto_hash\ndone\n\n: crypto_base64_encode def\n    >> bash -c \"printf '%s' '@_crypto_str' | base64 -w0\" |> @_crypto_result\ndone\n\n: crypto_base64_decode def\n    >> bash -c \"printf '%s' '@_crypto_str' | base64 -d\" |> @_crypto_result\ndone\n\n;; Generuj losowy token (hex)\n: crypto_random_hex def\n    ;; % _crypto_len = 32 && -- crypto_random_hex → @_crypto_result\n    >> bash -c \"dd if=/dev/urandom bs=1 count=@_crypto_len 2>/dev/null | xxd -p | tr -d '\\n'\" |> @_crypto_result\ndone\n\n;; Weryfikacja hash\n: crypto_verify def\n    ;; % _crypto_file = plik && % _crypto_expected = hash && -- crypto_verify\n    -- crypto_sha256_file\n    >> test \"@_crypto_hash\" = \"@_crypto_expected\"\ndone\n" end
    if name == "fs" is return ";;; main/fs.hl — System plikow\n;;; /usr/lib/HackerOS/Hacker-Lang/main-libs/fs.hl\nusing <gen 2>\n\n> echo \"$HOME\" |> @FS_HOME\n% FS_TMP       = /tmp\n% FS_ETC       = /etc\n% FS_VAR_LOG   = /var/log\n% FS_USR_BIN   = /usr/bin\n% FS_USR_LOCAL = /usr/local\n% FS_PROC      = /proc\n% FS_SYS       = /sys\n% FS_DEV       = /dev\n% FS_MEDIA     = /media\n% FS_MNT       = /mnt\n% FS_HACKEROS  = /usr/share/HackerOS\n% FS_HL_LIBS   = /usr/lib/HackerOS/Hacker-Lang\n\n;; Pomocnicze funkcje plikowe\n\n: fs_mktemp def\n    ;; Uzycie: -- fs_mktemp → @_fs_tmpfile\n    > mktemp |> @_fs_tmpfile\ndone\n\n: fs_size def\n    ;; Uzycie: % _fs_path = /sciezka && -- fs_size → @_fs_size\n    >> bash -c \"du -sh @_fs_path 2>/dev/null | cut -f1\" |> @_fs_size\ndone\n\n: fs_lines def\n    ;; Uzycie: % _fs_path = plik && -- fs_lines → @_fs_lines\n    >> bash -c \"wc -l < @_fs_path 2>/dev/null | tr -d ' '\" |> @_fs_lines\ndone\n\n: fs_ext def\n    ;; Uzycie: % _fs_path = plik.txt && -- fs_ext → @_fs_ext\n    >> bash -c \"echo @_fs_path | sed 's/.*\\\\.//'\" |> @_fs_ext\ndone\n" end
    if name == "hacker" is return ";;; main/hacker.hl — Parser plikow .hacker (v1, v2, v3)\n;;; Instalacja: plik w /usr/lib/HackerOS/Hacker-Lang/main-libs/hacker.hl\n;;; Uzycie: # <main/hacker>\n;;;\n;;; Format .hacker:\n;;;   v1:  [ dowolna zawartosc ]\n;;;   v2:  [ naglowek  sekcja:  = wartosc  sekcja2:  = wartosc2 ]\n;;;   v3:  [ = naglowek  => typ  -> opis  --> plik ]\nusing <gen 1>\n\n% HACKER_PARSER_LOADED  = true\n% HACKER_PARSER_VERSION = gen 1\n\n;; ── Wykrywanie wersji pliku .hacker ──────────────────────────────────────────\n\n: hacker_detect_version def\n    ;; Uzycie: % _hacker_file = plik.hacker, -- hacker_detect_version\n    ;; Ustawia %_hacker_version = 1|2|3\n\n    ::exists @_hacker_file\n    ? err\n        ::red Plik .hacker nie istnieje: @_hacker_file\n        > exit 1\n    done\n\n    ;; Sprawdz czy zawiera = (naglowek v3)\n    >> grep -q \"^[[:space:]]*= \" @_hacker_file\n    ? ok\n        % _hacker_version = 3\n    done\n\n    ;; Sprawdz czy zawiera sekcje z : (v2)\n    >> grep -q \":$\" @_hacker_file\n    ? ok\n        % _hacker_version = 2\n    done\n\n    ;; Domyslnie v1\n    % _hacker_version = 1\ndone\n\n;; ── Parser v1 ─────────────────────────────────────────────────────────────────\n\n: hacker_parse_v1 def\n    ;; Odczytaj zawartosc miedzy [ ]\n    >> sed -n 's/^[[:space:]]*\\[//;s/\\][[:space:]]*$//;p' @_hacker_file | head -1\ndone\n\n;; ── Parser v2 ─────────────────────────────────────────────────────────────────\n\n: hacker_parse_v2_header def\n    ;; Odczytaj naglowek (linie przed pierwsza sekcja :)\n    >> awk '/^[[:space:]]*[a-zA-Z].*:$/\u{7b\u{7d}exit\u{7d} \u{7b\u{7d}print\u{7d}' @_hacker_file | grep -v '^\\[' | grep -v '^\\]' | grep -v '^[[:space:]]*$' | head -1\ndone\n\n: hacker_parse_v2_section def\n    ;; Uzycie: % _hacker_section = jadro, -- hacker_parse_v2_section\n    ;; Wyswietla wartosci dla sekcji\n    >> awk \"/^[[:space:]]*@_hacker_section:/\u{7b\u{7d}found=1; next\u{7d} found && /^[[:space:]]*= /\u{7b\u{7d}sub(/^[[:space:]]*= /, \\\"\\\"); print\u{7d} found && /^[[:space:]]*[a-zA-Z].*:$/\u{7b\u{7d}exit\u{7d}\" @_hacker_file\ndone\n\n;; ── Parser v3 ─────────────────────────────────────────────────────────────────\n\n: hacker_parse_v3_header def\n    >> grep \"^[[:space:]]*= \" @_hacker_file | head -1 | sed 's/^[[:space:]]*= //'\ndone\n\n: hacker_parse_v3_type def\n    >> grep \"^[[:space:]]*=> \" @_hacker_file | head -1 | sed 's/^[[:space:]]*=> //'\ndone\n\n: hacker_parse_v3_description def\n    >> grep \"^[[:space:]]*-> \" @_hacker_file | head -1 | sed 's/^[[:space:]]*-> //'\ndone\n\n: hacker_parse_v3_file def\n    >> grep \"^[[:space:]]*--> \" @_hacker_file | head -1 | sed 's/^[[:space:]]*--> //'\ndone\n\n;; ── Glowna funkcja parsowania ─────────────────────────────────────────────────\n\n: hacker_parse def\n    ;; Uzycie: % _hacker_file = plik.hacker, -- hacker_parse\n    -- hacker_detect_version\n\n    > test \"@_hacker_version\" = \"3\"\n    ? ok\n        ~> [.hacker v3]\n        ~> Header:      \n        -- hacker_parse_v3_header\n        ~> Type:        \n        -- hacker_parse_v3_type\n        ~> Description: \n        -- hacker_parse_v3_description\n        ~> File:        \n        -- hacker_parse_v3_file\n    done\n\n    > test \"@_hacker_version\" = \"2\"\n    ? ok\n        ~> [.hacker v2]\n        ~> Header:\n        -- hacker_parse_v2_header\n    done\n\n    > test \"@_hacker_version\" = \"1\"\n    ? ok\n        ~> [.hacker v1]\n        -- hacker_parse_v1\n    done\ndone\n" end
    if name == "hbuild" is return "\n" end
    if name == "hk-parser" is return ";;; main/hk-parser.hl — Parser plikow .hk (HackerOS Configuration Format)\n;;; Instalacja: plik w /usr/lib/HackerOS/Hacker-Lang/main-libs/hk-parser.hl\n;;; Uzycie: # <main/hk-parser>\n;;; Format .hk oparty o implementacje Rust (hk-parser crate)\nusing <gen 1>\n\n% HK_PARSER_LOADED  = true\n% HK_PARSER_VERSION = gen 1\n\n;; ── Format .hk ────────────────────────────────────────────────────────────────\n;; Struktura pliku .hk:\n;;\n;;   ! Komentarz\n;;\n;;   [sekcja]\n;;   -> klucz => wartosc\n;;   -> klucz => 42\n;;   -> klucz => true\n;;   -> klucz => [1, 2, \"trzy\"]\n;;   -> zagniezdzona\n;;   --> podklucz => wartosc\n;;\n;; Interpolacja: $\u{7b\u{7d}sekcja.klucz\u{7d}  lub  $\u{7b\u{7d}env:ZMIENNA\u{7d}\n;;\n;; Wersjonowanie: HK_PARSER_VERSION = gen 1\n\n;; Odczytaj wartosc z pliku .hk uzywajac hk-tool (jesli dostepny)\n;; lub przez grep/awk jako fallback\n: hk_get def\n    ;; Uzycie: % _hk_file = plik.hk, % _hk_section = sekcja, % _hk_key = klucz, -- hk_get\n    ::which hk-tool\n    ? ok\n        >> hk-tool get @_hk_file @_hk_section @_hk_key\n    done\n    ? err\n        ;; Fallback: grep\n        >> grep -A100 \"\\[@_hk_section\\]\" @_hk_file | grep \"-> @_hk_key =>\" | head -1 | sed 's/.*=> //'\n    done\ndone\n\n;; Sprawdz czy sekcja istnieje\n: hk_has_section def\n    >> grep -q \"\\[@_hk_section\\]\" @_hk_file\ndone\n\n;; Listuj sekcje\n: hk_sections def\n    >> grep -o '\\[.*\\]' @_hk_file | tr -d '[]'\ndone\n\n;; Validacja pliku .hk (podstawowa)\n: hk_validate def\n    ::exists @_hk_file\n    ? ok\n        ::green Plik .hk istnieje: @_hk_file\n        -- hk_sections\n    done\n    ? err\n        ::red Plik .hk nie istnieje: @_hk_file\n    done\ndone\n" end
    if name == "json" is return ";;; main/json.hl — Parser JSON\n;;; /usr/lib/HackerOS/Hacker-Lang/main-libs/json.hl\nusing <gen 2>\n\n// jq\n\n% JSON_LOADED = true\n\n: json_get def\n    ;; % _json_file = plik.json && % _json_key = .klucz && -- json_get → stdout\n    >> jq -r \"@_json_key\" @_json_file\ndone\n\n: json_get_var def\n    ;; Jak json_get ale wynik do zmiennej @_json_result\n    >> jq -r \"@_json_key\" @_json_file |> @_json_result\ndone\n\n: json_set def\n    ;; % _json_file && % _json_key = .klucz && % _json_val = wartosc\n    >> bash -c \"jq '@_json_key = \\\"@_json_val\\\"' @_json_file > /tmp/_json_tmp.$$ && mv /tmp/_json_tmp.$$ @_json_file\"\ndone\n\n: json_array def\n    >> jq -r \"@_json_key[]\" @_json_file\ndone\n\n: json_keys def\n    >> jq -r \"@_json_key | keys[]\" @_json_file\ndone\n\n: json_has def\n    >> jq -e \"@_json_key\" @_json_file > /dev/null 2>&1\ndone\n\n: json_validate def\n    > jq empty @_json_file > /dev/null 2>&1\n    ? ok\n        ::green JSON OK: @_json_file\n    done\n    ? err\n        ::red JSON NIEPOPRAWNY: @_json_file\n    done\ndone\n\n: json_pretty def\n    >> jq . @_json_file\ndone\n\n: json_compact def\n    >> jq -c . @_json_file\ndone\n\n: json_merge def\n    ;; % _json_file1 && % _json_file2 && % _json_out — polacz dwa pliki JSON\n    >> jq -s '.[0] * .[1]' @_json_file1 @_json_file2 > @_json_out\ndone\n" end
    if name == "net" is return ";;; main/net.hl — Biblioteka sieciowa\n;;; /usr/lib/HackerOS/Hacker-Lang/main-libs/net.hl\nusing <gen 2>\n\n% NET_LOCALHOST  = 127.0.0.1\n% NET_BROADCAST  = 255.255.255.255\n% NET_IPV6_LOCAL = ::1\n\n;; Pobierz adres IP interfejsu\n> ip route get 1.1.1.1 2>/dev/null | awk '\u{7b\u{7d}print $7; exit\u{7d}' |> @NET_MYIP\n> ip route 2>/dev/null | awk '/default/\u{7b\u{7d}print $3; exit\u{7d}' |> @NET_GATEWAY\n> ip route 2>/dev/null | awk '/default/\u{7b\u{7d}print $5; exit\u{7d}' |> @NET_IFACE\n\n;; Porty standardowe\n% PORT_SSH    = 22\n% PORT_HTTP   = 80\n% PORT_HTTPS  = 443\n% PORT_FTP    = 21\n% PORT_SMTP   = 25\n% PORT_DNS    = 53\n% PORT_POP3   = 110\n% PORT_IMAP   = 143\n% PORT_MYSQL  = 3306\n% PORT_PGSQL  = 5432\n% PORT_REDIS  = 6379\n% PORT_MONGO  = 27017\n% PORT_LDAP   = 389\n% PORT_RDP    = 3389\n% PORT_VNC    = 5900\n% PORT_HTTP_ALT = 8080\n% PORT_HTTPS_ALT = 8443\n\n;; Sprawdz czy host odpowiada\n: net_ping def\n    ;; Uzycie: % _net_target = 192.168.1.1 && -- net_ping\n    >> bash -c \"ping -c 1 -W 2 @_net_target >/dev/null 2>&1\"\ndone\n\n;; Pobierz zewnetrzny IP\n: net_myip_public def\n    > curl -fsSL ifconfig.me 2>/dev/null |> @NET_PUBLIC_IP\ndone\n\n;; Sprawdz czy port jest otwarty\n: net_port_check def\n    ;; Uzycie: % _net_host = host && % _net_port = 80 && -- net_port_check\n    >> bash -c \"nc -z -w2 @_net_host @_net_port >/dev/null 2>&1\"\ndone\n" end
    if name == "proc" is return ";;; main/proc.hl — Informacje o procesach\n;;; /usr/lib/HackerOS/Hacker-Lang/main-libs/proc.hl\nusing <gen 2>\n\n> echo $$ |> @PROC_SELF_PID\n> echo $PPID |> @PROC_PPID\n\n: proc_list def\n    > ps aux\ndone\n\n: proc_kill def\n    ;; % _proc_pid = 1234 && -- proc_kill\n    >> kill @_proc_pid\ndone\n\n: proc_kill_name def\n    ;; % _proc_name = nginx && -- proc_kill_name\n    >> pkill @_proc_name\ndone\n\n: proc_find def\n    ;; % _proc_name = nginx && -- proc_find → @_proc_pids\n    >> pgrep @_proc_name |> @_proc_pids\ndone\n\n: proc_is_running def\n    ;; % _proc_name = nginx && -- proc_is_running → exit 0/1\n    >> pgrep -x @_proc_name > /dev/null 2>&1\ndone\n\n: proc_wait def\n    ;; % _proc_pid = 1234 && -- proc_wait\n    >> wait @_proc_pid\ndone\n" end
    if name == "progress-bar" is return "#!/usr/bin/hl\n;;; main/progress-bar.hl — Pasek postepu (produkcyjny)\n;;; /usr/lib/HackerOS/Hacker-Lang/main-libs/progress-bar.hl\nusing <gen 2>\n\n% PROGRESS_BAR_WIDTH   = 20\n% PROGRESS_BAR_LOADED  = true\n\n;; Rysuj pasek postepu\n;; Uzycie: % _pb_pct = 0..100 && -- pb_draw\n;; Format: [--->............] [30%]\n: pb_draw def\n    >> bash -c \"\n        PCT=@_pb_pct\n        FILL=\\$(( PCT * @PROGRESS_BAR_WIDTH / 100 ))\n        EMPTY=\\$(( @PROGRESS_BAR_WIDTH - FILL ))\n        DASHES=\\$(( FILL > 0 ? FILL - 1 : 0 ))\n        BAR='['\n        i=0; while [ \\$i -lt \\$DASHES ]; do BAR=\\\"\\$\u{7b\u{7d}BAR\u{7d}-\\\"; i=\\$((\\$i+1)); done\n        [ \\$FILL -gt 0 ] && BAR=\\\"\\$\u{7b\u{7d}BAR\u{7d}>\\\"\n        i=0; while [ \\$i -lt \\$EMPTY ]; do BAR=\\\"\\$\u{7b\u{7d}BAR\u{7d}.\\\"; i=\\$((\\$i+1)); done\n        BAR=\\\"\\$\u{7b\u{7d}BAR\u{7d}]\\\"\n        printf '\\r\\033[36m%s\\033[0m \\033[33m[%d%%]\\033[0m' \\\"\\$BAR\\\" \\$PCT\n    \"\ndone\n\n;; Zakonczenie paska (nowa linia)\n: pb_done def\n    ~> \ndone\n\n;; Pasek z etykieta\n;; Uzycie: % _pb_pct = 50 && % _pb_label = \"Pobieranie\" && -- pb_label\n: pb_label def\n    >> bash -c \"\n        PCT=@_pb_pct\n        FILL=\\$(( PCT * @PROGRESS_BAR_WIDTH / 100 ))\n        EMPTY=\\$(( @PROGRESS_BAR_WIDTH - FILL ))\n        DASHES=\\$(( FILL > 0 ? FILL - 1 : 0 ))\n        BAR='['\n        i=0; while [ \\$i -lt \\$DASHES ]; do BAR=\\\"\\$\u{7b\u{7d}BAR\u{7d}-\\\"; i=\\$((\\$i+1)); done\n        [ \\$FILL -gt 0 ] && BAR=\\\"\\$\u{7b\u{7d}BAR\u{7d}>\\\"\n        i=0; while [ \\$i -lt \\$EMPTY ]; do BAR=\\\"\\$\u{7b\u{7d}BAR\u{7d}.\\\"; i=\\$((\\$i+1)); done\n        BAR=\\\"\\$\u{7b\u{7d}BAR\u{7d}]\\\"\n        printf '\\r\\033[36m%-15s\\033[0m %s \\033[33m[%d%%]\\033[0m' \\\"@_pb_label\\\" \\\"\\$BAR\\\" \\$PCT\n    \"\ndone\n\n;; Animowany spinner (do zadan bez procentow)\n;; Uzycie: % _spinner_msg = \"Ladowanie\" && -- pb_spin_tick (wywoluj w petli)\n% _spinner_frame = 0\n\n: pb_spin_tick def\n    >> bash -c \"\n        FRAMES='|/-\\\\'\n        F=\\$(( @_spinner_frame % 4 ))\n        printf '\\r\\033[36m%s\\033[0m %s' \\\"\\$\u{7b\u{7d}FRAMES:\\$F:1\u{7d}\\\" \\\"@_spinner_msg\\\"\n    \"\n    $( @_spinner_frame + 1 ) -> @_spinner_frame\ndone\n" end
    if name == "str" is return ";;; main/str.hl — Stale i funkcje stringowe\n;;; /usr/lib/HackerOS/Hacker-Lang/main-libs/str.hl\nusing <gen 2>\n\n% STR_NEWLINE = \\n\n% STR_TAB     = \\t\n% STR_SPACE   = \" \"\n% STR_EMPTY   = \"\"\n\n;; Kolory ANSI (alias do main/colors)\n% STR_RED     = \\033[31m\n% STR_GREEN   = \\033[32m\n% STR_YELLOW  = \\033[33m\n% STR_RESET   = \\033[0m\n% STR_BOLD    = \\033[1m\n\n;; Konwersja\n: str_to_upper def\n    ;; % _str = wartosc && -- str_to_upper → @_str_result\n    >> bash -c \"printf '%s' '@_str' | tr '[:lower:]' '[:upper:]'\" |> @_str_result\ndone\n\n: str_to_lower def\n    >> bash -c \"printf '%s' '@_str' | tr '[:upper:]' '[:lower:]'\" |> @_str_result\ndone\n\n: str_trim def\n    >> bash -c \"printf '%s' '@_str' | sed 's/^[[:space:]]*//;s/[[:space:]]*\\$//'\" |> @_str_result\ndone\n\n: str_len def\n    >> bash -c \"printf '%s' '@_str' | wc -c | tr -d ' '\" |> @_str_len\ndone\n\n: str_replace def\n    ;; % _str = tekst && % _str_from = stary && % _str_to = nowy && -- str_replace\n    >> bash -c \"printf '%s' '@_str' | sed 's/@_str_from/@_str_to/g'\" |> @_str_result\ndone\n\n: str_contains def\n    ;; % _str = tekst && % _str_sub = szukaj && -- str_contains → exit 0/1\n    >> bash -c \"printf '%s' '@_str' | grep -qF '@_str_sub'\"\ndone\n\n: str_starts_with def\n    >> bash -c \"printf '%s' '@_str' | grep -q '^@_str_prefix'\"\ndone\n\n: str_ends_with def\n    >> bash -c \"printf '%s' '@_str' | grep -q '@_str_suffix\\$'\"\ndone\n\n: str_split def\n    ;; % _str = a:b:c && % _str_sep = : && -- str_split (wypisuje linie)\n    >> bash -c \"printf '%s' '@_str' | tr '@_str_sep' '\\n'\"\ndone\n\n: str_join def\n    ;; Uzyj bash array lub prostego rozwiazania\n    >> bash -c \"printf '%s' '@_str' | tr '\\n' '@_str_sep' | sed 's/@_str_sep\\$//'\"\ndone\n" end
    if name == "sys" is return ";;; main/sys.hl — Informacje systemowe\n;;; /usr/lib/HackerOS/Hacker-Lang/main-libs/sys.hl\nusing <gen 2>\n\n> uname -m |> @SYS_ARCH\n> uname -r |> @SYS_KERNEL\n> uname -s |> @SYS_OS_NAME\n> cat /etc/hostname 2>/dev/null |> @SYS_HOSTNAME\n> cat /etc/os-release 2>/dev/null | grep \"^PRETTY_NAME\" | cut -d'\"' -f2 |> @SYS_OS\n> nproc 2>/dev/null |> @SYS_CPU_CORES\n> grep -c processor /proc/cpuinfo 2>/dev/null |> @SYS_CPU\n> free -h 2>/dev/null | awk '/^Mem:/\u{7b\u{7d}print $2\u{7d}' |> @SYS_MEMTOTAL\n> free -h 2>/dev/null | awk '/^Mem:/\u{7b\u{7d}print $3\u{7d}' |> @SYS_MEMUSED\n> uptime -p 2>/dev/null |> @SYS_UPTIME\n> id -u |> @SYS_UID\n> id -un |> @SYS_USER\n% SYS_HACKEROS_VER = gen 2\n\n;; Sprawdz czy root\n: sys_is_root def\n    > test \"@SYS_UID\" = \"0\"\ndone\n\n;; Pobierz wersje pakietu\n: sys_pkg_version def\n    ;; % _sys_pkg = curl && -- sys_pkg_version → @_sys_pkg_ver\n    >> bash -c \"@_sys_pkg --version 2>/dev/null | head -1\" |> @_sys_pkg_ver\ndone\n\n;; Restart uslugi (wymaga sudo)\n: sys_restart def\n    ;; % _sys_service = nginx && -- sys_restart\n    ^>> systemctl restart @_sys_service\ndone\n\n;; Status uslugi\n: sys_status def\n    ;; % _sys_service = nginx && -- sys_status\n    >> systemctl is-active @_sys_service |> @_sys_service_status\ndone\n" end
    return ""

pub fn is_digit_b(c: int) -> bool is
    return c >= 48 && c <= 57
end

pub fn is_alpha_b(c: int) -> bool is
    if c >= 97 && c <= 122 is return true end
    if c >= 65 && c <= 90 is return true end
    let hi: int = 128
    return c >= hi
end

pub fn is_ident_b(c: int) -> bool is
    return is_alpha_b(c) || is_digit_b(c) || c == 95
end

pub fn is_space_b(c: int) -> bool is
    return c == 32 || c == 9 || c == 13
end

pub fn trim(s: string) -> string is
    return string_trim(s)
end

pub fn starts(s: string, p: string) -> bool is
    return string_starts_with(s, p)
end

pub fn ends(s: string, p: string) -> bool is
    return string_ends_with(s, p)
end

pub fn sub(s: string, a: int, b: int) -> string is
    let n: int = string_len(s)
    let mut x: int = a
    let mut y: int = b
    if x < 0 is x = 0 end
    if y > n is y = n end
    if x >= y is return "" end
    return string_slice(s, x, y)
end

pub fn from(s: string, a: int) -> string is
    return sub(s, a, string_len(s))
end

pub fn has(s: string, p: string) -> bool is
    return string_find(s, p) >= 0
end

;; split on runs of whitespace (space/tab/newline)
pub fn words(s: string) -> [string] is
    let bs: [int] = string_to_bytes(s)
    let n: int = array_len(bs)
    let mut out: [string] = []
    let mut i: int = 0
    let mut st: int = -1
    while i < n is
        let c: int = bs[i]
        let sp: bool = c == 32 || c == 9 || c == 10 || c == 13
        if sp is
            if st >= 0 is
                out = array_push(out, string_slice(s, st, i))
                st = -1
            end
        else is
            if st < 0 is st = i end
        end
        i += 1
    end
    if st >= 0 is out = array_push(out, string_slice(s, st, n)) end
    return out
end

pub fn join(parts: [string], sep: string) -> string is
    let mut r: string = ""
    let mut i: int = 0
    let n: int = array_len(parts)
    while i < n is
        if i > 0 is r = r + sep end
        r = r + parts[i]
        i += 1
    end
    return r
end

;; shell-like word split honouring '..' and ".." (quotes are dropped, empty quoted words kept)
pub fn shell_words(s: string) -> [string] is
    let bs: [int] = string_to_bytes(s)
    let n: int = array_len(bs)
    let mut out: [string] = []
    let mut cur: string = ""
    let mut in_s: bool = false
    let mut in_d: bool = false
    let mut had: bool = false
    let mut i: int = 0
    while i < n is
        let c: int = bs[i]
        if c == 39 && !in_d is
            in_s = !in_s
            had = true
        else if c == 34 && !in_s is
            in_d = !in_d
            had = true
        else if (c == 32 || c == 9) && !in_s && !in_d is
            if string_len(cur) > 0 || had is
                out = array_push(out, cur)
                cur = ""
                had = false
            end
        else is
            cur = cur + string_slice(s, i, i + 1)
        end
        i += 1
    end
    if string_len(cur) > 0 || had is out = array_push(out, cur) end
    return out
end

;; last space-separated word split: ("a b c") -> ("a b", "c")
pub fn split_last(s: string) -> [string] is
    let p: int = string_rfind(s, " ")
    if p < 0 is return [s, ""] end
    return [string_trim(string_slice(s, 0, p)), string_trim(string_slice(s, p + 1, string_len(s)))]
end

;; first space split: ("a b c") -> ("a", "b c")
pub fn split_first(s: string) -> [string] is
    let p: int = string_find(s, " ")
    if p < 0 is return [string_trim(s), ""] end
    return [string_trim(string_slice(s, 0, p)), string_trim(string_slice(s, p + 1, string_len(s)))]
end

pub fn repeat_str(s: string, n: int) -> string is
    let mut r: string = ""
    let mut i: int = 0
    while i < n is
        r = r + s
        i += 1
    end
    return r
end

;; parse a (possibly negative) decimal integer; ok=false when not a pure integer
pub struct IntParse is
    pub ok: bool
    pub v: int
end

pub fn parse_i(s: string) -> IntParse is
    let t: string = string_trim(s)
    let bs: [int] = string_to_bytes(t)
    let n: int = array_len(bs)
    if n == 0 is return IntParse { ok: false, v: 0 } end
    let mut i: int = 0
    let mut neg: bool = false
    if bs[0] == 45 || bs[0] == 43 is
        neg = bs[0] == 45
        i = 1
    end
    if i >= n is return IntParse { ok: false, v: 0 } end
    if n - i > 18 is return IntParse { ok: false, v: 0 } end
    let mut v: int = 0
    while i < n is
        if !is_digit_b(bs[i]) is return IntParse { ok: false, v: 0 } end
        v = v * 10 + (bs[i] - 48)
        i += 1
    end
    if neg is v = 0 - v end
    return IntParse { ok: true, v: v }
end

pub fn int_or(s: string, d: int) -> int is
    let p: IntParse = parse_i(s)
    if p.ok is return p.v end
    return d
end

;; leading ASCII upper/lower mapping (UTF-8 bytes >= 128 untouched)
pub fn up(s: string) -> string is
    return string_upper(s)
end

pub fn low(s: string) -> string is
    return string_lower(s)
end

;; basename / dirname with both separators
pub fn basename(p: string) -> string is
    let a: int = string_rfind(p, "/")
    let b: int = string_rfind(p, "\\")
    let mut k: int = a
    if b > k is k = b end
    if k < 0 is return p end
    return string_slice(p, k + 1, string_len(p))
end

pub fn dirname(p: string) -> string is
    let a: int = string_rfind(p, "/")
    let b: int = string_rfind(p, "\\")
    let mut k: int = a
    if b > k is k = b end
    if k < 0 is return "." end
    if k == 0 is return "/" end
    return string_slice(p, 0, k)
end

;; quote a string for the platform shell (POSIX single quotes / Windows double quotes)
pub fn shq(s: string, windows: bool) -> string is
    if windows is
        return "\"" + string_replace_all(s, "\"", "\\\"") + "\""
    end
    return "'" + string_replace_all(s, "'", "'\\''") + "'"
end

;; byte-wise comparison: -1, 0, 1
pub fn cmp_str(a: string, b: string) -> int is
    let x: [int] = string_to_bytes(a)
    let y: [int] = string_to_bytes(b)
    let nx: int = array_len(x)
    let ny: int = array_len(y)
    let mut n: int = nx
    if ny < n is n = ny end
    let mut i: int = 0
    while i < n is
        if x[i] < y[i] is return 0 - 1 end
        if x[i] > y[i] is return 1 end
        i += 1
    end
    if nx < ny is return 0 - 1 end
    if nx > ny is return 1 end
    return 0
end

;; Shell sort (gaps 1,4,13,40..) — no recursion, no allocation besides the result copy.
pub fn sort_strs(a: [string]) -> [string] is
    let mut v: [string] = a
    let n: int = array_len(v)
    let mut gap: int = 1
    while gap < n / 3 is gap = gap * 3 + 1 end
    while gap >= 1 is
        let mut i: int = gap
        while i < n is
            let t: string = v[i]
            let mut j: int = i
            while j >= gap && cmp_str(v[j - gap], t) > 0 is
                v[j] = v[j - gap]
                j = j - gap
            end
            v[j] = t
            i += 1
        end
        gap = gap / 3
    end
    return v
end

;; split on an arbitrary separator, dropping empty pieces
pub fn words_by(s: string, sep: string) -> [string] is
    let mut out: [string] = []
    let sl: int = string_len(sep)
    let mut from: int = 0
    let n: int = string_len(s)
    while from <= n is
        let rest: string = string_slice(s, from, n)
        let k: int = string_find(rest, sep)
        if k < 0 is
            if string_len(rest) > 0 is out = array_push(out, rest) end
            break
        end
        if k > 0 is out = array_push(out, string_slice(rest, 0, k)) end
        from = from + k + sl
    end
    return out
end

mod jit_ir

struct Cx is
    out: string
    nv: int            ;; next value number
    nb: int            ;; next free block number
    xb: int            ;; first exit block: exit e is block (xb + e)
end

fn v(cx: Cx) -> string is
    cx.nv += 1
    return "v" + to_string(cx.nv)
end

fn ln(cx: Cx, s: string) is
    cx.out = cx.out + "    " + s + "\n"
end

fn blk(cx: Cx, id: int) is
    cx.out = cx.out + "block" + to_string(id) + ":\n"
end

fn off(r: int) -> string is return to_string(r * 8) end

fn cc_name(k: int) -> string is
    ;; k = 0..5 : eq ne ge le gt lt   (cmpv order of the IR)
    if k == 0 is return "eq" end
    if k == 1 is return "ne" end
    if k == 2 is return "sge" end
    if k == 3 is return "sle" end
    if k == 4 is return "sgt" end
    return "slt"
end

fn load_reg(cx: Cx, r: int) -> string is
    let t: string = v(cx)
    ln(cx, t + " = load.i64 notrap aligned v0+" + off(r))
    return t
end

fn store_reg(cx: Cx, r: int, val: string) is
    ln(cx, "store notrap aligned " + val + ", v0+" + off(r))
end

fn store_rt(cx: Cx, r: int, ty: int) is
    if r < jit_ir::home_base() is
        let t: string = v(cx)
        ln(cx, t + " = iconst.i64 " + to_string(ty))
        ln(cx, "store notrap aligned " + t + ", v1+" + off(r))
    end
end

fn iconst(cx: Cx, n: int) -> string is
    let t: string = v(cx)
    ln(cx, t + " = iconst.i64 " + to_string(n))
    return t
end

;; -lim < x < lim  as one i8 value
fn in_range(cx: Cx, x: string, lim: int) -> string is
    let a: string = v(cx)
    let b: string = v(cx)
    let c: string = v(cx)
    ln(cx, a + " = icmp_imm slt " + x + ", " + to_string(lim))
    ln(cx, b + " = icmp_imm sgt " + x + ", " + to_string(0 - lim))
    ln(cx, c + " = band " + a + ", " + b)
    return c
end

;; branch to `exit block e` unless `ok`; continue in a fresh block
fn guard(cx: Cx, ok: string, e: int) is
    let nxt: int = cx.nb
    cx.nb += 1
    ln(cx, "brif " + ok + ", block" + to_string(nxt) + ", block" + to_string(cx.xb + e))
    blk(cx, nxt)
end

fn next_jump(cx: Cx, i: int) is
    ln(cx, "jump block" + to_string(i + 2))
end

fn emit_arith(cx: Cx, op: int, d: int, a: int, b: int, e: int, i: int) is
    let la: int = jit_ir::lim_add()
    let lm: int = jit_ir::lim_mul()
    let imm: bool = op >= 9 && op <= 13
    let mut kind: int = op
    if imm is kind = op - 6 end            ;; addi..remi -> add..rem
    let x: string = load_reg(cx, a)
    let mut y: string = ""
    if imm is y = iconst(cx, b) else is y = load_reg(cx, b) end
    let r: string = v(cx)
    if kind == 3 || kind == 4 is
        let mut ok: string = in_range(cx, x, la)
        if !imm is
            let ok2: string = in_range(cx, y, la)
            let both: string = v(cx)
            ln(cx, both + " = band " + ok + ", " + ok2)
            ok = both
        end
        guard(cx, ok, e)
        if kind == 3 is ln(cx, r + " = iadd " + x + ", " + y) else is ln(cx, r + " = isub " + x + ", " + y) end
    else if kind == 5 is
        let mut ok: string = in_range(cx, x, lm)
        if !imm is
            let ok2: string = in_range(cx, y, lm)
            let both: string = v(cx)
            ln(cx, both + " = band " + ok + ", " + ok2)
            ok = both
        end
        guard(cx, ok, e)
        ln(cx, r + " = imul " + x + ", " + y)
    else is
        ;; div / rem with x/0 = 0, x/-1 handled without trapping
        let z: string = v(cx)
        let m1: string = v(cx)
        let zm: string = v(cx)
        ln(cx, z + " = icmp_imm eq " + y + ", 0")
        ln(cx, m1 + " = icmp_imm eq " + y + ", -1")
        ln(cx, zm + " = bor " + z + ", " + m1)
        let one: string = iconst(cx, 1)
        let ys: string = v(cx)
        ln(cx, ys + " = select " + zm + ", " + one + ", " + y)
        let rm: string = v(cx)
        ln(cx, rm + " = srem " + x + ", " + ys)
        if kind == 7 is
            let zero: string = iconst(cx, 0)
            ln(cx, r + " = select " + zm + ", " + zero + ", " + rm)
        else is
            ;; exact-or-deopt: divisor 0 and -1 are always fine, otherwise the remainder must be 0
            let rz: string = v(cx)
            let okd: string = v(cx)
            ln(cx, rz + " = icmp_imm eq " + rm + ", 0")
            ln(cx, okd + " = bor " + zm + ", " + rz)
            guard(cx, okd, e)
            let q: string = v(cx)
            ln(cx, q + " = sdiv " + x + ", " + ys)
            let nx: string = v(cx)
            ln(cx, nx + " = ineg " + x)
            let q2: string = v(cx)
            ln(cx, q2 + " = select " + m1 + ", " + nx + ", " + q)
            let zero2: string = iconst(cx, 0)
            ln(cx, r + " = select " + z + ", " + zero2 + ", " + q2)
        end
    end
    store_reg(cx, d, r)
end

fn emit_instr(cx: Cx, rg: jit_ir::Region, i: int) is
    let b: int = i * 6
    let op: int = rg.code[b]
    let d: int = rg.code[b + 1]
    let a: int = rg.code[b + 2]
    let bb: int = rg.code[b + 3]
    let c: int = rg.code[b + 4]
    let e: int = rg.code[b + 5]
    if op == jit_ir::j_nop() is
        if bb == 1 && d < jit_ir::home_base() is store_rt(cx, d, 1) end
        next_jump(cx, i)
    else if op == jit_ir::j_const() is
        store_reg(cx, d, iconst(cx, a))
        store_rt(cx, d, bb)
        next_jump(cx, i)
    else if op == jit_ir::j_mov() is
        store_reg(cx, d, load_reg(cx, a))
        store_rt(cx, d, bb)
        next_jump(cx, i)
    else if (op >= 3 && op <= 7) || (op >= 9 && op <= 13) is
        emit_arith(cx, op, d, a, bb, e, i)
        next_jump(cx, i)
    else if op == jit_ir::j_neg() is
        let x: string = load_reg(cx, a)
        let r: string = v(cx)
        ln(cx, r + " = ineg " + x)
        store_reg(cx, d, r)
        next_jump(cx, i)
    else if op == jit_ir::j_jmp() is
        ln(cx, "jump block" + to_string(a + 1))
    else if op >= 15 && op <= 20 is
        let x: string = load_reg(cx, a)
        let y: string = load_reg(cx, bb)
        let t: string = v(cx)
        ln(cx, t + " = icmp " + cc_name(op - 15) + " " + x + ", " + y)
        ln(cx, "brif " + t + ", block" + to_string(c + 1) + ", block" + to_string(i + 2))
    else if op >= 21 && op <= 26 is
        let x: string = load_reg(cx, a)
        let t: string = v(cx)
        ln(cx, t + " = icmp_imm " + cc_name(op - 21) + " " + x + ", " + to_string(bb))
        ln(cx, "brif " + t + ", block" + to_string(c + 1) + ", block" + to_string(i + 2))
    else if op == jit_ir::j_winit() is
        let z: string = iconst(cx, 0)
        ln(cx, "store notrap aligned " + z + ", v2+" + off(d))
        next_jump(cx, i)
    else if op == jit_ir::j_tick() is
        let cnt: string = v(cx)
        ln(cx, cnt + " = load.i64 notrap aligned v2+" + off(d))
        let lt: string = v(cx)
        ln(cx, lt + " = icmp_imm slt " + cnt + ", " + to_string(jit_ir::while_limit()))
        guard(cx, lt, e)
        let inc: string = v(cx)
        ln(cx, inc + " = iadd_imm " + cnt + ", 1")
        ln(cx, "store notrap aligned " + inc + ", v2+" + off(d))
        let tk: string = v(cx)
        ln(cx, tk + " = load.i64 notrap aligned v4+8")
        let tk2: string = v(cx)
        ln(cx, tk2 + " = iadd_imm " + tk + ", 1")
        ln(cx, "store notrap aligned " + tk2 + ", v4+8")
        next_jump(cx, i)
    else if op == jit_ir::j_rinit() is
        let n: string = iconst(cx, a)
        ln(cx, "store notrap aligned " + n + ", v3+" + off(d))
        next_jump(cx, i)
    else if op == jit_ir::j_rnext() is
        let cnt: string = v(cx)
        ln(cx, cnt + " = load.i64 notrap aligned v3+" + off(d))
        let le: string = v(cx)
        ln(cx, le + " = icmp_imm sle " + cnt + ", 0")
        let body: int = cx.nb
        cx.nb += 1
        ln(cx, "brif " + le + ", block" + to_string(a + 1) + ", block" + to_string(body))
        blk(cx, body)
        let dec: string = v(cx)
        ln(cx, dec + " = iadd_imm " + cnt + ", -1")
        ln(cx, "store notrap aligned " + dec + ", v3+" + off(d))
        next_jump(cx, i)
    else if op == jit_ir::j_setx() is
        let z: string = iconst(cx, 0)
        ln(cx, "store notrap aligned " + z + ", v4+0")
        next_jump(cx, i)
    else if op == jit_ir::j_jlxok() || op == jit_ir::j_jlxerr() is
        let lx: string = v(cx)
        ln(cx, lx + " = load.i64 notrap aligned v4+0")
        let t: string = v(cx)
        let mut cc: string = "eq"
        if op == jit_ir::j_jlxerr() is cc = "ne" end
        ln(cx, t + " = icmp_imm " + cc + " " + lx + ", 0")
        ln(cx, "brif " + t + ", block" + to_string(a + 1) + ", block" + to_string(i + 2))
    else if op == jit_ir::j_exit() is
        ln(cx, "jump block" + to_string(cx.xb + e))
    else is
        ;; printreg / printlit / printfmt / printvar: the VM performs the instruction (call-out)
        let r: string = v(cx)
        ln(cx, r + " = iconst.i32 " + to_string(0 - (i + 1)))
        ln(cx, "return " + r)
    end
end

;; true when the instruction can be executed natively (everything but the print call-outs)
pub fn is_native_op(op: int) -> bool is
    return !(op == jit_ir::j_printreg() || op == jit_ir::j_printlit() || op == jit_ir::j_printfmt() || op == jit_ir::j_printvar())
end

;; number of call-out instructions (0 = region runs entirely natively until it exits)
pub fn callouts(rg: jit_ir::Region) -> int is
    let mut n: int = 0
    let mut i: int = 0
    while i < rg.n is
        if !is_native_op(rg.code[i * 6]) is n += 1 end
        i += 1
    end
    return n
end

pub fn emit_mem(rg: jit_ir::Region, name: string) -> string is
    let cx: Cx = Cx { out: "", nv: 5, nb: rg.n + 2 + rg.nex, xb: rg.n + 2 }
    cx.out = "function %" + name + "(i64, i64, i64, i64, i64, i32) -> i32 system_v {\n"
    ;; jump table: start ip -> block
    let mut targets: string = ""
    let mut i: int = 0
    while i < rg.n is
        if i > 0 is targets = targets + ", " end
        targets = targets + "block" + to_string(i + 1)
        i += 1
    end
    cx.out = cx.out + "block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i32):\n"
    ln(cx, "br_table v5, block" + to_string(rg.n + 1) + ", [" + targets + "]")
    let mut k: int = 0
    while k < rg.n is
        blk(cx, k + 1)
        emit_instr(cx, rg, k)
        k += 1
    end
    blk(cx, rg.n + 1)
    ln(cx, "trap user1")
    let mut e: int = 0
    while e < rg.nex is
        blk(cx, cx.xb + e)
        let r: string = v(cx)
        ln(cx, r + " = iconst.i32 " + to_string(e))
        ln(cx, "return " + r)
        e += 1
    end
    cx.out = cx.out + "}\n"
    return cx.out
end

;; ═════════════════════════════════════════════════════════════════════════════
;; register-allocated emitter: every IR register / loop counter / status lives in an SSA value; basic blocks pass
;; them as block parameters, so Cranelift keeps them in machine registers.  Memory is touched only at region
;; entry (load) and at exits / call-outs (flush).  Same ABI and same guards as `emit_mem`.
;; ═════════════════════════════════════════════════════════════════════════════
struct Sx is
    out: string
    nv: int
    nb: int
    xb: int
    cur: [string]        ;; current SSA value per slot ("" = undefined)
    np: int              ;; number of persistent slots
    ps: [int]            ;; persistent slots (homes, counters, st0, st1)
    nr: int              ;; slot of cw[0]  (= number of register slots)
    ncw: int
    ncr: int
    bad: bool
end

fn sv(cx: Sx) -> string is
    cx.nv += 1
    return "v" + to_string(cx.nv)
end

fn sl(cx: Sx, s: string) is
    cx.out = cx.out + "    " + s + "\n"
end

fn sblk(cx: Sx, id: int) is
    cx.out = cx.out + "block" + to_string(id) + ":\n"
end

fn slot_cw(cx: Sx, d: int) -> int is return cx.nr + d end
fn slot_cr(cx: Sx, d: int) -> int is return cx.nr + cx.ncw + d end
fn slot_st0(cx: Sx) -> int is return cx.nr + cx.ncw + cx.ncr end
fn slot_st1(cx: Sx) -> int is return cx.nr + cx.ncw + cx.ncr + 1 end

fn sget(cx: Sx, slot: int) -> string is
    let x: string = cx.cur[slot]
    if string_len(x) == 0 is
        cx.bad = true
        return "v0"
    end
    return x
end

fn sset(cx: Sx, slot: int, val: string) is
    cx.cur[slot] = val
end

fn sconst(cx: Sx, n: int) -> string is
    let t: string = sv(cx)
    sl(cx, t + " = iconst.i64 " + to_string(n))
    return t
end

;; "(v1, v2, ...)" — current values of the persistent slots
fn sargs(cx: Sx) -> string is
    let mut o: string = "("
    let mut i: int = 0
    while i < cx.np is
        if i > 0 is o = o + ", " end
        o = o + sget(cx, cx.ps[i])
        i += 1
    end
    return o + ")"
end

;; declare fresh block parameters for the persistent slots; temps become undefined
fn sparams(cx: Sx) -> string is
    let mut j: int = 0
    while j < array_len(cx.cur) is
        cx.cur[j] = ""
        j += 1
    end
    let mut o: string = "("
    let mut i: int = 0
    while i < cx.np is
        let t: string = sv(cx)
        if i > 0 is o = o + ", " end
        o = o + t + ": i64"
        cx.cur[cx.ps[i]] = t
        i += 1
    end
    return o + ")"
end

fn saddr(slot: int, cx: Sx) -> string is
    ;; memory location of a persistent slot
    if slot < cx.nr is return "v0+" + to_string(slot * 8) end
    if slot < cx.nr + cx.ncw is return "v2+" + to_string((slot - cx.nr) * 8) end
    if slot < cx.nr + cx.ncw + cx.ncr is return "v3+" + to_string((slot - cx.nr - cx.ncw) * 8) end
    if slot == cx.nr + cx.ncw + cx.ncr is return "v4+0" end
    return "v4+8"
end

;; store every persistent slot to its memory home
fn sflush(cx: Sx) is
    let mut i: int = 0
    while i < cx.np is
        let sl0: int = cx.ps[i]
        sl(cx, "store notrap aligned " + sget(cx, sl0) + ", " + saddr(sl0, cx))
        i += 1
    end
end

fn sstore_rt(cx: Sx, r: int, ty: int) is
    if r < jit_ir::home_base() is
        let t: string = sv(cx)
        sl(cx, t + " = iconst.i64 " + to_string(ty))
        sl(cx, "store notrap aligned " + t + ", v1+" + to_string(r * 8))
    end
end

fn sin_range(cx: Sx, x: string, lim: int) -> string is
    let a: string = sv(cx)
    let b: string = sv(cx)
    let c: string = sv(cx)
    sl(cx, a + " = icmp_imm slt " + x + ", " + to_string(lim))
    sl(cx, b + " = icmp_imm sgt " + x + ", " + to_string(0 - lim))
    sl(cx, c + " = band " + a + ", " + b)
    return c
end

fn sguard(cx: Sx, ok: string, e: int) is
    let nxt: int = cx.nb
    cx.nb += 1
    sl(cx, "brif " + ok + ", block" + to_string(nxt) + ", block" + to_string(cx.xb + e) + sargs(cx))
    sblk(cx, nxt)
end

fn sarith(cx: Sx, op: int, d: int, a: int, b: int, e: int) is
    let la: int = jit_ir::lim_add()
    let lm: int = jit_ir::lim_mul()
    let imm: bool = op >= 9 && op <= 13
    let mut kind: int = op
    if imm is kind = op - 6 end
    let x: string = sget(cx, a)
    let mut y: string = ""
    if imm is y = sconst(cx, b) else is y = sget(cx, b) end
    let r: string = sv(cx)
    if kind == 3 || kind == 4 || kind == 5 is
        let mut lim: int = la
        if kind == 5 is lim = lm end
        let mut ok: string = sin_range(cx, x, lim)
        if !imm is
            let ok2: string = sin_range(cx, y, lim)
            let both: string = sv(cx)
            sl(cx, both + " = band " + ok + ", " + ok2)
            ok = both
        end
        sguard(cx, ok, e)
        if kind == 3 is sl(cx, r + " = iadd " + x + ", " + y) end
        if kind == 4 is sl(cx, r + " = isub " + x + ", " + y) end
        if kind == 5 is sl(cx, r + " = imul " + x + ", " + y) end
    else is
        let z: string = sv(cx)
        let m1: string = sv(cx)
        let zm: string = sv(cx)
        sl(cx, z + " = icmp_imm eq " + y + ", 0")
        sl(cx, m1 + " = icmp_imm eq " + y + ", -1")
        sl(cx, zm + " = bor " + z + ", " + m1)
        let one: string = sconst(cx, 1)
        let ys: string = sv(cx)
        sl(cx, ys + " = select " + zm + ", " + one + ", " + y)
        let rm: string = sv(cx)
        sl(cx, rm + " = srem " + x + ", " + ys)
        if kind == 7 is
            let zero: string = sconst(cx, 0)
            sl(cx, r + " = select " + zm + ", " + zero + ", " + rm)
        else is
            let rz: string = sv(cx)
            let okd: string = sv(cx)
            sl(cx, rz + " = icmp_imm eq " + rm + ", 0")
            sl(cx, okd + " = bor " + zm + ", " + rz)
            sguard(cx, okd, e)
            let q: string = sv(cx)
            sl(cx, q + " = sdiv " + x + ", " + ys)
            let nx: string = sv(cx)
            sl(cx, nx + " = ineg " + x)
            let q2: string = sv(cx)
            sl(cx, q2 + " = select " + m1 + ", " + nx + ", " + q)
            let zero2: string = sconst(cx, 0)
            sl(cx, r + " = select " + z + ", " + zero2 + ", " + q2)
        end
    end
    sset(cx, d, r)
end

fn is_term(op: int) -> bool is
    return op == jit_ir::j_jmp() || (op >= 15 && op <= 26) || op == jit_ir::j_rnext() || op == jit_ir::j_jlxok() || op == jit_ir::j_jlxerr() || op == jit_ir::j_exit() || !is_native_op(op)
end

;; one IR instruction; returns nothing — every terminator leaves the CLIF block closed
fn semit(cx: Sx, rg: jit_ir::Region, i: int, nextlead: bool) is
    let b: int = i * 6
    let op: int = rg.code[b]
    let d: int = rg.code[b + 1]
    let a: int = rg.code[b + 2]
    let bb: int = rg.code[b + 3]
    let c: int = rg.code[b + 4]
    let e: int = rg.code[b + 5]
    let nxt: string = "block" + to_string(i + 2)
    if op == jit_ir::j_nop() is
        if bb == 1 && d < jit_ir::home_base() is sstore_rt(cx, d, 1) end
    else if op == jit_ir::j_const() is
        sset(cx, d, sconst(cx, a))
        sstore_rt(cx, d, bb)
    else if op == jit_ir::j_mov() is
        sset(cx, d, sget(cx, a))
        sstore_rt(cx, d, bb)
    else if (op >= 3 && op <= 7) || (op >= 9 && op <= 13) is
        sarith(cx, op, d, a, bb, e)
    else if op == jit_ir::j_neg() is
        let r: string = sv(cx)
        sl(cx, r + " = ineg " + sget(cx, a))
        sset(cx, d, r)
    else if op == jit_ir::j_jmp() is
        sl(cx, "jump block" + to_string(a + 1) + sargs(cx))
    else if op >= 15 && op <= 20 is
        let t: string = sv(cx)
        sl(cx, t + " = icmp " + cc_name(op - 15) + " " + sget(cx, a) + ", " + sget(cx, bb))
        sl(cx, "brif " + t + ", block" + to_string(c + 1) + sargs(cx) + ", " + nxt + sargs(cx))
    else if op >= 21 && op <= 26 is
        let t: string = sv(cx)
        sl(cx, t + " = icmp_imm " + cc_name(op - 21) + " " + sget(cx, a) + ", " + to_string(bb))
        sl(cx, "brif " + t + ", block" + to_string(c + 1) + sargs(cx) + ", " + nxt + sargs(cx))
    else if op == jit_ir::j_winit() is
        sset(cx, slot_cw(cx, d), sconst(cx, 0))
    else if op == jit_ir::j_tick() is
        let cnt: string = sget(cx, slot_cw(cx, d))
        let lt: string = sv(cx)
        sl(cx, lt + " = icmp_imm slt " + cnt + ", " + to_string(jit_ir::while_limit()))
        sguard(cx, lt, e)
        let inc: string = sv(cx)
        sl(cx, inc + " = iadd_imm " + cnt + ", 1")
        sset(cx, slot_cw(cx, d), inc)
        let tk: string = sv(cx)
        sl(cx, tk + " = iadd_imm " + sget(cx, slot_st1(cx)) + ", 1")
        sset(cx, slot_st1(cx), tk)
    else if op == jit_ir::j_rinit() is
        sset(cx, slot_cr(cx, d), sconst(cx, a))
    else if op == jit_ir::j_rnext() is
        let cnt: string = sget(cx, slot_cr(cx, d))
        let le: string = sv(cx)
        sl(cx, le + " = icmp_imm sle " + cnt + ", 0")
        let body: int = cx.nb
        cx.nb += 1
        sl(cx, "brif " + le + ", block" + to_string(a + 1) + sargs(cx) + ", block" + to_string(body))
        sblk(cx, body)
        let dec: string = sv(cx)
        sl(cx, dec + " = iadd_imm " + cnt + ", -1")
        sset(cx, slot_cr(cx, d), dec)
        sl(cx, "jump " + nxt + sargs(cx))
    else if op == jit_ir::j_setx() is
        sset(cx, slot_st0(cx), sconst(cx, 0))
    else if op == jit_ir::j_jlxok() || op == jit_ir::j_jlxerr() is
        let t: string = sv(cx)
        let mut cc: string = "eq"
        if op == jit_ir::j_jlxerr() is cc = "ne" end
        sl(cx, t + " = icmp_imm " + cc + " " + sget(cx, slot_st0(cx)) + ", 0")
        sl(cx, "brif " + t + ", block" + to_string(a + 1) + sargs(cx) + ", " + nxt + sargs(cx))
    else if op == jit_ir::j_exit() is
        sl(cx, "jump block" + to_string(cx.xb + e) + sargs(cx))
    else is
        ;; call-out: flush, hand control to the VM
        sflush(cx)
        if op == jit_ir::j_printreg() && a >= jit_ir::home_base() is
            sl(cx, "store notrap aligned " + sget(cx, a) + ", v0+" + to_string(a * 8))
        end
        let r: string = sv(cx)
        sl(cx, r + " = iconst.i32 " + to_string(0 - (i + 1)))
        sl(cx, "return " + r)
    end
    ;; fall through into the next instruction's block
    if !is_term(op) && i + 1 < rg.n && nextlead is
        sl(cx, "jump " + nxt + sargs(cx))
    end
end

pub fn emit(rg: jit_ir::Region, name: string) -> string is
    let nr: int = jit_ir::home_base() + rg.ntemps + 1
    let ncw: int = array_len(rg.cw)
    let ncr: int = array_len(rg.cr)
    let total: int = nr + ncw + ncr + 2
    let mut cur: [string] = []
    let mut ps: [int] = []
    let mut z: int = 0
    while z < total is
        cur = array_push(cur, "")
        z += 1
    end
    let mut h: int = 0
    while h < rg.nhome is
        ps = array_push(ps, h)
        h += 1
    end
    let mut q: int = nr
    while q < total is
        ps = array_push(ps, q)
        q += 1
    end
    let n: int = rg.n
    let cx: Sx = Sx { out: "", nv: 5, nb: n + 2 + rg.nex, xb: n + 2, cur: cur, np: array_len(ps), ps: ps, nr: nr, ncw: ncw, ncr: ncr, bad: false }
    ;; leaders: 0, jump targets, instructions after terminators
    let mut lead: [int] = []
    let mut k: int = 0
    while k < n is
        lead = array_push(lead, 0)
        k += 1
    end
    if n > 0 is lead[0] = 1 end
    let mut ent: [int] = []
    let mut k2: int = 0
    while k2 < n is
        ent = array_push(ent, 0)
        k2 += 1
    end
    if n > 0 is ent[0] = 1 end
    let mut i: int = 0
    while i < n is
        let op: int = rg.code[i * 6]
        if jit_ir::is_jump(op) is
            let t: int = rg.code[i * 6 + jit_ir::target_field(op)]
            if t >= 0 && t < n is lead[t] = 1 end
        end
        if is_term(op) && i + 1 < n is
            lead[i + 1] = 1
            if !is_native_op(op) is ent[i + 1] = 1 end
        end
        i += 1
    end
    cx.out = "function %" + name + "(i64, i64, i64, i64, i64, i32) -> i32 system_v {\n"
    cx.out = cx.out + "block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i32):\n"
    ;; entry stubs: load the persistent slots from memory, jump to the leader
    let mut stubs: [int] = []
    let mut targets: string = ""
    let mut m: int = 0
    while m < n is
        if m > 0 is targets = targets + ", " end
        if ent[m] == 1 is
            stubs = array_push(stubs, m)
            targets = targets + "block" + to_string(cx.nb + array_len(stubs) - 1)
        else is
            targets = targets + "block" + to_string(n + 1)
        end
        m += 1
    end
    sl(cx, "br_table v5, block" + to_string(n + 1) + ", [" + targets + "]")
    let stub_base: int = cx.nb
    cx.nb += array_len(stubs)
    let mut sI: int = 0
    while sI < array_len(stubs) is
        sblk(cx, stub_base + sI)
        let mut j: int = 0
        let mut o: string = "("
        while j < cx.np is
            let t: string = sv(cx)
            sl(cx, t + " = load.i64 notrap aligned " + saddr(cx.ps[j], cx))
            if j > 0 is o = o + ", " end
            o = o + t
            j += 1
        end
        sl(cx, "jump block" + to_string(stubs[sI] + 1) + o + ")")
        sI += 1
    end
    ;; instruction blocks
    let mut x: int = 0
    while x < n is
        if lead[x] == 1 is
            cx.out = cx.out + "block" + to_string(x + 1) + sparams(cx) + ":\n"
        end
        semit(cx, rg, x, x + 1 < n && lead[x + 1] == 1)
        x += 1
    end
    sblk(cx, n + 1)
    sl(cx, "trap user1")
    let mut e: int = 0
    while e < rg.nex is
        cx.out = cx.out + "block" + to_string(cx.xb + e) + sparams(cx) + ":\n"
        sflush(cx)
        let r: string = sv(cx)
        sl(cx, r + " = iconst.i32 " + to_string(e))
        sl(cx, "return " + r)
        e += 1
    end
    cx.out = cx.out + "}\n"
    if cx.bad is return emit_mem(rg, name) end
    return cx.out
end

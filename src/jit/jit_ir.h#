;; ── region ──────────────────────────────────────────────────────────────────
pub struct Region is
    pub entry_pc: int
    pub kind: int                 ;; 1 = while loop (entry at whtick), 2 = repeat loop (entry at rptnext)
    pub code: [int]
    pub n: int                    ;; instruction count
    pub nhome: int
    pub home_slot: [int]
    pub home_read: [int]          ;; 1 = value is read in the region => guarded + loaded at entry
    pub home_dirty: [int]         ;; 1 = assigned in the region => flushed at exits
    pub ex: [int]                 ;; 6 ints per exit: resume_pc wd rd flag chain_start chain_len
    pub nex: int
    pub chain: [int]              ;; return pcs of inlined call frames, outermost first
    pub fmt_start: [int]          ;; print formats: pieces [start, start+cnt) in pk/pv
    pub fmt_cnt: [int]
    pub pk: [int]                 ;; piece kind: 0 literal (pv = lit idx), 1 home reg (pv = reg), 2 VM variable (pv = slot)
    pub pv: [int]
    pub epoch: int
    pub uses_calls: bool
    pub ntemps: int
    pub regs: [int]
    pub rt: [int]
    pub cw: [int]
    pub cr: [int]
    pub state: int                ;; 0 new, 1 ready, 2 rejected, 3 disabled
    pub why: string
    pub entries: int
    pub deopts: int
    pub guard_fails: int
    pub iters: int
    pub native: int               ;; native handle (0 = none)
    pub native_state: int         ;; 0 untried, 1 ok, 2 unavailable/failed
    pub src_lines: int
end

pub fn new_region(entry_pc: int, kind: int) -> Region is
    return Region { entry_pc: entry_pc, kind: kind, code: [], n: 0, nhome: 0, home_slot: [], home_read: [], home_dirty: [],
                    ex: [], nex: 0, chain: [], fmt_start: [], fmt_cnt: [], pk: [], pv: [], epoch: 0, uses_calls: false,
                    ntemps: 0, regs: [], rt: [], cw: [], cr: [], state: 0, why: "", entries: 0, deopts: 0, guard_fails: 0,
                    iters: 0, native: 0, native_state: 0, src_lines: 0 }
end

pub fn emit(rg: Region, op: int, d: int, a: int, b: int, c: int, e: int) -> int is
    let at: int = rg.n
    rg.code = array_push(rg.code, op)
    rg.code = array_push(rg.code, d)
    rg.code = array_push(rg.code, a)
    rg.code = array_push(rg.code, b)
    rg.code = array_push(rg.code, c)
    rg.code = array_push(rg.code, e)
    rg.n += 1
    return at
end

;; find-or-add an exit descriptor (dedup on pc/wd/rd/flag/chain)
pub fn add_exit(rg: Region, pc: int, wd: int, rd: int, flag: int, chain: [int]) -> int is
    let mut i: int = 0
    while i < rg.nex is
        let b: int = i * 6
        if rg.ex[b] == pc && rg.ex[b + 1] == wd && rg.ex[b + 2] == rd && rg.ex[b + 3] == flag && rg.ex[b + 5] == array_len(chain) is
            let mut same: bool = true
            let mut k: int = 0
            while k < array_len(chain) is
                if rg.chain[rg.ex[b + 4] + k] != chain[k] is same = false end
                k += 1
            end
            if same is return i end
        end
        i += 1
    end
    let cs: int = array_len(rg.chain)
    let mut k2: int = 0
    while k2 < array_len(chain) is
        rg.chain = array_push(rg.chain, chain[k2])
        k2 += 1
    end
    rg.ex = array_push(rg.ex, pc)
    rg.ex = array_push(rg.ex, wd)
    rg.ex = array_push(rg.ex, rd)
    rg.ex = array_push(rg.ex, flag)
    rg.ex = array_push(rg.ex, cs)
    rg.ex = array_push(rg.ex, array_len(chain))
    rg.nex += 1
    return rg.nex - 1
end

pub fn add_fmt(rg: Region, kinds: [int], vals: [int]) -> int is
    rg.fmt_start = array_push(rg.fmt_start, array_len(rg.pk))
    rg.fmt_cnt = array_push(rg.fmt_cnt, array_len(kinds))
    let mut i: int = 0
    while i < array_len(kinds) is
        rg.pk = array_push(rg.pk, kinds[i])
        rg.pv = array_push(rg.pv, vals[i])
        i += 1
    end
    return array_len(rg.fmt_start) - 1
end

pub fn is_jump(op: int) -> bool is
    return op == 14 || (op >= 15 && op <= 26) || op == 30 || op == 35 || op == 36
end

;; which field of a jump instruction holds the target IR index
pub fn target_field(op: int) -> int is
    if op == 14 || op == 30 || op == 35 || op == 36 is return 2 end
    return 4
end

pub fn is_guarded(op: int) -> bool is
    return (op >= 3 && op <= 7) || (op >= 9 && op <= 13) || op == 28
end

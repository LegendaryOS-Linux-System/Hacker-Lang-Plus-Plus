fn version() -> string is
    return "0.1.0"
end

fn usage() is
    hlpp_sys::outln(hlpp_diag::brand() + " " + colors::dim(version()) + colors::dim("  — LegendaryOS"))
    hlpp_sys::outln("")
    hlpp_sys::outln(colors::bold("Użycie:"))
    hlpp_sys::outln("  hlpp <plik.hl> [argumenty...]      uruchom program (to samo co `hlpp run`)")
    hlpp_sys::outln("  hlpp run <plik.hl> [argumenty...]  uruchom")
    hlpp_sys::outln("  hlpp check <plik.hl>               tylko kompilacja do bytecode (diagnostyka)")
    hlpp_sys::outln("  hlpp dump <plik.hl>                zdezasembluj bytecode HLPB")
    hlpp_sys::outln("  hlpp -e '<kod>'                    wykonaj fragment")
    hlpp_sys::outln("  hlpp repl                          interaktywna pętla")
    hlpp_sys::outln("  hlpp version | help")
    hlpp_sys::outln("")
    hlpp_sys::outln(colors::bold("Opcje:") + "  --trace  ślad instrukcji (stderr)   --stats  statystyki wykonania   --no-color")
    hlpp_sys::outln("")
    hlpp_sys::outln(colors::bold("Gen:") + "  `using <gen 2026>` / `using <ROLLING>`;  zgodność z hl: `gen 1`, `gen 2`")
end

fn setup_vm(p: hlpp_prog::Prog, rest: [string]) -> hlpp_vm::VM is
    let vm: hlpp_vm::VM = hlpp_vm::new_vm(p)
    vm.shell = hlpp_sys::shell_program()
    vm.win = hlpp_sys::is_windows()
    vm.args = rest
    vm.script = p.file
    vm.trace = hlpp_sys::has_env("HLPP_TRACE")
    return vm
end

;; $1.. $9 and ARGC are exposed as variables so scripts can read their arguments
fn export_args(vm: hlpp_vm::VM) is
    hlpp_vm::ensure_slots(vm)
    let n: int = array_len(vm.args)
    hlpp_vm::set_dyn(vm, "ARGC", to_string(n), 2)
    let mut i: int = 0
    while i < n is
        hlpp_vm::set_dyn(vm, "ARG" + to_string(i + 1), vm.args[i], 1)
        i += 1
    end
    hlpp_vm::set_dyn(vm, "SCRIPT", vm.script, 1)
    ;; variables predefined by hl (Env::new) + Hacker Lang++ ones
    if vm.p.edition >= 1 is
        hlpp_vm::set_dyn(vm, "HL_VERSION", "gen 2026", 1)
        hlpp_vm::set_dyn(vm, "HL_GEN", "2026", 1)
    else is
        hlpp_vm::set_dyn(vm, "HL_VERSION", "gen 2", 1)
        hlpp_vm::set_dyn(vm, "HL_GEN", "2", 1)
    end
    hlpp_vm::set_dyn(vm, "HL_OS", hlpp_sys::platform_name(), 1)
    hlpp_vm::set_dyn(vm, "HLPP_VERSION", version(), 1)
end

fn compile_file(path: string, src: string) -> hlpp_prog::Prog is
    let p: hlpp_prog::Prog = hlpp_prog::new_prog(0, path)
    p.src = src
    hlpp_comp::compile_chunk(p, src, true)
    return p
end

fn cmd_run(path: string, rest: [string], stats: bool, trace: bool) -> int is
    if !hlpp_sys::is_file(path) is
        hlpp_diag::plain_error("nie znaleziono pliku '" + path + "'")
        return 2
    end
    let src: string = hlpp_sys::read(path)
    let p: hlpp_prog::Prog = compile_file(path, src)
    if hlpp_diag::compile_errors(p, src) > 0 is return 2 end
    let main_end: int = hlpp_prog::here(p)
    let vm: hlpp_vm::VM = setup_vm(p, rest)
    if trace is vm.trace = true end
    export_args(vm)
    let t0: int = hlpp_sys::now_ms()
    hlpp_exec::run(vm)
    if string_len(vm.err) > 0 is
        hlpp_diag::runtime_error(vm, src, main_end)
    end
    if stats is
        let dt: int = hlpp_sys::now_ms() - t0
        let ops: int = vm.stats_ops
        let objs: int = hlpp_oop::live_count(vm)
        hlpp_sys::err(colors::dim("[hlpp] " + to_string(ops) + " instrukcji, " + to_string(dt) + " ms, żywych obiektów: " + to_string(objs) + ", stos wywołań: " + to_string(vm.rsp)) + "\n")
    end
    return vm.exit_code
end

fn cmd_check(path: string) -> int is
    if !hlpp_sys::is_file(path) is
        hlpp_diag::plain_error("nie znaleziono pliku '" + path + "'")
        return 2
    end
    let src: string = hlpp_sys::read(path)
    let p: hlpp_prog::Prog = compile_file(path, src)
    if hlpp_diag::compile_errors(p, src) > 0 is return 1 end
    let n: int = hlpp_prog::here(p)
    hlpp_diag::ok(path + ": " + to_string(n) + " instrukcji HLPB, " + to_string(array_len(p.lits)) + " literałów, " + to_string(array_len(p.names)) + " zmiennych")
    return 0
end

fn cmd_dump(path: string) -> int is
    if !hlpp_sys::is_file(path) is
        hlpp_diag::plain_error("nie znaleziono pliku '" + path + "'")
        return 2
    end
    let src: string = hlpp_sys::read(path)
    let p: hlpp_prog::Prog = compile_file(path, src)
    if hlpp_diag::compile_errors(p, src) > 0 is return 1 end
    hlpp_dump::dump(p)
    return 0
end

fn cmd_eval(code: string, stats: bool) -> int is
    let p: hlpp_prog::Prog = hlpp_prog::new_prog(0, "<-e>")
    p.src = code
    hlpp_comp::compile_chunk(p, code, true)
    if hlpp_diag::compile_errors(p, code) > 0 is return 1 end
    let main_end: int = hlpp_prog::here(p)
    let vm: hlpp_vm::VM = setup_vm(p, [])
    hlpp_exec::run(vm)
    if string_len(vm.err) > 0 is hlpp_diag::runtime_error(vm, code, main_end) end
    return vm.exit_code
end

fn cmd_repl() -> int is
    hlpp_sys::outln(hlpp_diag::brand() + " " + colors::dim(version()) + colors::dim("  — :q kończy, wielolinijkowe bloki kończ `done`"))
    let p: hlpp_prog::Prog = hlpp_prog::new_prog(1, "<repl>")
    let vm: hlpp_vm::VM = setup_vm(p, [])
    vm.running = false
    let mut buf: string = ""
    let mut depth: int = 0
    while true is
        if depth == 0 is hlpp_sys::out(colors::bright_cyan("hl++> ")) else is hlpp_sys::out(colors::dim("...   ")) end
        let line: string = read_line()
        if line == "\u{4}" || (depth == 0 && (string_trim(line) == ":q" || string_trim(line) == "exit")) is break end
        buf = buf + line + "\n"
        let t: string = string_trim(line)
        if string_ends_with(t, " def") || string_starts_with(t, "?~") || string_starts_with(t, "@ ") || string_starts_with(t, "?") is depth += 1 end
        if t == "done" is depth -= 1 end
        if depth > 0 is continue end
        depth = 0
        let before: int = array_len(p.errs)
        let entry: int = hlpp_comp::compile_chunk(p, buf, false)
        let msg: string = buf
        buf = ""
        if array_len(p.errs) > before is
            hlpp_diag::report("<repl>", msg, p.err_lines[before], "hlpp::compile", p.errs[before], "tutaj", "")
            continue
        end
        hlpp_vm::ensure_slots(vm)
        hlpp_vm::ensure_code(vm)
        hlpp_vm::ensure_lits(vm)
        vm.err = ""
        vm.running = true
        vm.rsp = 0
        vm.sp = 0
        vm.pc = entry
        hlpp_exec::run(vm)
        if string_len(vm.err) > 0 is
            hlpp_diag::runtime_error(vm, msg, hlpp_prog::here(p))
        end
    end
    return 0
end

fn main() is
    let all: [string] = env::args()
    let mut a: [string] = []
    let mut stats: bool = false
    let mut trace: bool = false
    let mut i: int = 1
    while i < array_len(all) is
        if all[i] == "--stats" is stats = true
        else if all[i] == "--trace" is trace = true
        else if all[i] == "--no-color" is colors::disable()
        else is a = array_push(a, all[i]) end
        i += 1
    end
    if array_len(a) == 0 is
        usage()
        exit(0)
    end
    let cmd: string = a[0]
    let mut rest: [string] = []
    let mut k: int = 1
    while k < array_len(a) is
        rest = array_push(rest, a[k])
        k += 1
    end
    let mut code: int = 0
    if cmd == "help" || cmd == "--help" || cmd == "-h" is
        usage()
    else if cmd == "version" || cmd == "--version" || cmd == "-V" is
        hlpp_sys::outln("hlpp " + version())
        hlpp_sys::outln("  " + hlpp_jit::status())
    else if cmd == "check" is
        if array_len(rest) < 1 is
            hlpp_diag::plain_error("check wymaga ścieżki pliku")
            code = 2
        else is
            code = cmd_check(rest[0])
        end
    else if cmd == "dump" is
        if array_len(rest) < 1 is
            hlpp_diag::plain_error("dump wymaga ścieżki pliku")
            code = 2
        else is
            code = cmd_dump(rest[0])
        end
    else if cmd == "repl" is
        code = cmd_repl()
    else if cmd == "-e" is
        if array_len(rest) < 1 is
            hlpp_diag::plain_error("-e wymaga kodu")
            code = 2
        else is
            code = cmd_eval(rest[0], stats)
        end
    else if cmd == "run" is
        if array_len(rest) < 1 is
            hlpp_diag::plain_error("run wymaga ścieżki pliku")
            code = 2
        else is
            let mut r2: [string] = []
            let mut j: int = 1
            while j < array_len(rest) is
                r2 = array_push(r2, rest[j])
                j += 1
            end
            code = cmd_run(rest[0], r2, stats, trace)
        end
    else is
        code = cmd_run(cmd, rest, stats, trace)
    end
    hlpp_sys::flush_out()
    exit(code)
end

using <gen 2026>
;; showcase: przeglad jezyka Hacker Lang++ w jednym pliku
;; (zmienne, arytmetyka, petle + JIT, funkcje, switch, napisy, komendy, OOP)

~> --- zmienne i arytmetyka ---
% name = Hacker Lang++
% n: int = 6
$( @n * 7 ) -> @answer
~> @name: @n * 7 = @answer

~> --- petla while (JIT) ---
% i: int = 1
% fact: int = 1
?~ @i <= 10
    $( @fact * @i ) -> @fact
    $( @i + 1 ) -> @i
done
~> 10! = @fact

~> --- powtorzenie _N ---
% k: int = 0
_1000 $( @k + 2 ) -> @k
~> k = @k

~> --- funkcja ---
: cube def
    $( @_x * @_x * @_x ) -> @_out
done
% _x: int = 5
-- cube
~> 5^3 = @_out

~> --- switch ---
% day = tue
? switch @day
| mon
    ~> poniedzialek
| tue
    ~> wtorek
| *
    ~> inny dzien
done

~> --- napisy ---
::upper hacker |> @up
::len @up |> @ln
~> @up (@ln znakow)

~> --- komenda zewnetrzna i status ---
> true
? ok
    ~> true -> sukces
done
> false
? err
    ~> false -> blad (kod @_exit)
done

~> --- OOP ---
:+ Greeter def
  % who = swiat
  :. hello def
    ~> Czesc, @self.who!
  done
done
+> Greeter g
.> g hello
:- g

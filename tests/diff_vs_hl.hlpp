#!/usr/bin/env bash
# Differential test: run every .hl program with the reference `hl` and with `hlpp`,
# compare stdout and exit code.  usage: tests/diff_vs_hl.sh <hl-binary> <hlpp-binary> <path>...
# NOTE: reference hl double-encodes non-ASCII source text (bytes treated as Latin-1); we undo it
# by comparing the ASCII subset only (hlpp prints the correct UTF-8).  See docs/HL_DIVERGENCES.md.
HL=$(realpath "$1"); HLPP=$(realpath "$2"); shift 2
pass=0; fail=0; failed=()
T=$(mktemp -d)
for f in $(find "$@" -name '*.hl' | sort); do
  d=$(dirname "$f"); b=$(basename "$f")
  (cd "$d" && HL_NOT_ON_HACKEROS=YES timeout 10 "$HL" run "$b" >"$T/e.raw" 2>"$T/e.err" </dev/null); ec=$?
  LC_ALL=C tr -cd '\000-\177' <"$T/e.raw" >"$T/e.out"
  (cd "$d" && timeout 10 "$HLPP" "$b" >"$T/g.raw" 2>"$T/g.err" </dev/null); gc=$?
  LC_ALL=C tr -cd '\000-\177' <"$T/g.raw" >"$T/g.out"
  if cmp -s "$T/e.out" "$T/g.out" && [ "$ec" == "$gc" ]; then pass=$((pass+1)); else fail=$((fail+1)); failed+=("$f (hl=$ec hlpp=$gc)"); fi
done
echo "pass=$pass fail=$fail"; printf '%s\n' "${failed[@]}"

use <mode:website>

!! Strona Hacker Lang++ — napisana w HackerScript, tryb `use <mode:website>`.
!! Budowanie:  hackerc website cmd/main.hcs -o dist    (dist/index.html + dist/app.js)
!! Przyklady i wyjscia pochodza z templates/ i tests/expected/ (generowane skryptem, nie przepisywane recznie).



style {
    :root { --tlo: #0b0912; --panel: #14111f; --panel2: #1b1729; --linia: #2a2440; --tekst: #e8e6f2; --przygas: #9a95b3; --akcent: #38c8ff; --akcent2: #b07cff; --ok: #4ade80; }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; background: var(--tlo); color: var(--tekst); font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; line-height: 1.6; }
    #app { max-width: 1040px; margin: 0 auto; padding: 0 20px 60px; }
    header.top { padding: 34px 0 8px; }
    header.top h1 { margin: 0; font-size: 2.1rem; letter-spacing: -0.02em; }
    header.top h1 span { color: var(--akcent); }
    header.top p { margin: 4px 0 0; color: var(--przygas); }
    nav { display: flex; flex-wrap: wrap; gap: 6px; margin: 18px 0 26px; padding: 6px; background: var(--panel); border: 1px solid var(--linia); border-radius: 14px; }
    .nav-link { color: var(--przygas); text-decoration: none; padding: 8px 14px; border-radius: 10px; font-size: .95rem; }
    .nav-link:hover { color: var(--tekst); background: var(--panel2); }
    .nav-link.active { color: #04202b; background: var(--akcent); font-weight: 600; }
    h2 { font-size: 1.5rem; margin: 34px 0 10px; letter-spacing: -0.01em; }
    h3 { margin: 0 0 6px; font-size: 1.05rem; }
    p { margin: 8px 0; }
    .lead { font-size: 1.15rem; color: var(--przygas); max-width: 62ch; }
    .hero { padding: 26px 0 10px; }
    .hero h2 { font-size: 2.3rem; margin-top: 8px; max-width: 20ch; line-height: 1.15; }
    .odznaki { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0; }
    .odznaka { border: 1px solid var(--linia); background: var(--panel); border-radius: 999px; padding: 4px 12px; font-size: .85rem; color: var(--przygas); }
    .odznaka b { color: var(--akcent); font-weight: 600; }
    .siatka { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin: 14px 0; }
    .karta { background: var(--panel); border: 1px solid var(--linia); border-radius: 14px; padding: 16px 18px; }
    .karta:hover { border-color: var(--akcent2); }
    .karta p { color: var(--przygas); margin: 4px 0 0; font-size: .95rem; }
    .tier { border-left: 4px solid var(--akcent); }
    .tier.t1 { border-left-color: var(--akcent2); }
    .tier.t2 { border-left-color: var(--ok); }
    pre.kod { background: #07050d; border: 1px solid var(--linia); border-radius: 12px; padding: 14px 16px; overflow-x: auto; font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: .86rem; line-height: 1.5; margin: 10px 0; white-space: pre; }
    pre.wyj { border-color: #1f3a2a; color: #b7f5cf; }
    code.in { background: var(--panel2); border-radius: 6px; padding: 1px 6px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .88em; }
    table { width: 100%; border-collapse: collapse; margin: 10px 0; font-size: .93rem; }
    th, td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--linia); vertical-align: top; }
    th { color: var(--przygas); font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; }
    td.sk { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: .86rem; color: var(--akcent); white-space: pre-wrap; }
    .zakladki { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0; }
    button.zak { background: var(--panel); color: var(--przygas); border: 1px solid var(--linia); border-radius: 10px; padding: 6px 12px; cursor: pointer; font-size: .85rem; font-family: inherit; }
    button.zak:hover { color: var(--tekst); border-color: var(--akcent2); }
    button.zak.aktywna { background: var(--akcent); color: #04202b; border-color: var(--akcent); font-weight: 600; }
    .dwa { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .uwaga { border: 1px solid #5a3b1a; background: #1d1409; border-radius: 12px; padding: 12px 16px; color: #f3d9b1; margin: 14px 0; }
    .uwaga b { color: #ffb454; }
    footer { margin-top: 50px; padding-top: 18px; border-top: 1px solid var(--linia); color: var(--przygas); font-size: .88rem; }
    @media (max-width: 760px) { .dwa { grid-template-columns: 1fr; } .hero h2 { font-size: 1.7rem; } header.top h1 { font-size: 1.6rem; } }
}

let ex_nazwa = [
    "hello.hl++",
    "variables_types.hl++",
    "functions.hl++",
    "switch_demo.hl++",
    "string_tools.hl++",
    "fizzbuzz.hl++",
    "fibonacci.hl++",
    "primes.hl++",
    "gcd_lcm.hl++",
    "collatz.hl++",
    "jit_bench.hl++",
    "loops_and_math.hl++",
    "oop_basic.hlpp",
    "oop_counter.hlpp",
    "oop_inheritance.hlpp",
    "oop_bank.hlpp",
    "import_demo.hl++",
    "coreutils_demo.hl++",
    "showcase.hl++"
]

let ex_kod = [
    "using <gen 2026>\n;; hello.hl++ — najprostszy program Hacker Lang++\n;; uruchom: hlpp templates/hello.hl++\n\n% name = Hacker Lang++\n% year: int = 2026\n\n~> Witaj, @name!\n~> Gen @year — bytecode VM + JIT (Cranelift)",
    "using <gen 2026>\n;; zmienne: bez typu, typowane, arytmetyka natywna $( ) i interpolacja\n\n% greeting = hello\n% count: int = 42\n% ratio: float = 2.5\n% active: bool = true\n% label: str = typed string\n\n~> greeting=@greeting count=@count ratio=@ratio active=@active label=@label\n\n$( @count * 2 ) -> @double\n$( @count + 8 ) -> @plus\n$( @count % 5 ) -> @rest\n$( (2 + 3) * 4 ) -> @paren\n~> double=@double plus=@plus rest=@rest paren=@paren\n\n;; wynik wyrazenia jako wartosc zmiennej\n% sum: int = $( 10 + 20 + 30 )\n~> sum=@sum\n\n;; zmienne zlozone: nazwa zmiennej z innej zmiennej\n% which = count\n~> @{which} = @count",
    "using <gen 2026>\n;; funkcje: \": nazwa def ... done\", wywolanie \"-- nazwa\"; parametry przez zmienne _nazwa\n\n: square def\n    $( @_x * @_x ) -> @_out\ndone\n\n: sum_squares def\n    % _acc: int = 0\n    % _k: int = 1\n    ?~ @_k <= @_n\n        % _x = @_k\n        -- square\n        $( @_acc + @_out ) -> @_acc\n        $( @_k + 1 ) -> @_k\n    done\ndone\n\n: banner def\n    ~> == @_title ==\ndone\n\n% _title = Funkcje\n-- banner\n\n% _x: int = 12\n-- square\n~> 12^2 = @_out\n\n% _n: int = 10\n-- sum_squares\n~> suma kwadratow 1..10 = @_acc",
    "using <gen 2026>\n;; switch: dopasowanie literalow, domyslne ramie \"*\"\n\n: describe def\n    ? switch @_code\n    | 200\n        ~> @_code OK\n    | 404\n        ~> @_code Not Found\n    | 500\n        ~> @_code Server Error\n    | *\n        ~> @_code nieznany kod\n    done\ndone\n\n% _code = 200\n-- describe\n% _code = 404\n-- describe\n% _code = 500\n-- describe\n% _code = 418\n-- describe\n\n% cmd = start\n? switch @cmd\n| start\n    ~> uruchamiam\n| stop\n    ~> zatrzymuje\n| *\n    ~> ???\ndone",
    "using <gen 2026>\n;; funkcje szybkie \"::\" na napisach\n\n::upper hello world |> @u\n::lower HACKER LANG |> @l\n::len Hacker Lang++ |> @n\n::rev stressed |> @r\n::replace foo-bar-baz - _ |> @rp\n~> upper=@u lower=@l len=@n rev=@r replace=@rp\n\n::contains hacker-lang lang\n? ok\n    ~> zawiera \"lang\"\ndone\n::startswith hacker-lang hack\n? ok\n    ~> zaczyna sie od \"hack\"\ndone\n::endswith hacker-lang xyz\n? err\n    ~> nie konczy sie na \"xyz\"\ndone\n\n::repeat ab 3 |> @rep\n~> repeat=@rep\n::max 3 9 |> @mx\n::min 3 9 |> @mn\n::abs -17 |> @ab\n~> max=@mx min=@mn abs=@ab",
    "using <gen 2026>\n;; klasyczny FizzBuzz 1..15: petla ?~ + zagniezdzony switch\n\n% i: int = 1\n?~ @i <= 15\n    $( @i % 3 ) -> @m3\n    $( @i % 5 ) -> @m5\n    ? switch @m3\n    | 0\n        ? switch @m5\n        | 0\n            ~> FizzBuzz\n        | *\n            ~> Fizz\n        done\n    | *\n        ? switch @m5\n        | 0\n            ~> Buzz\n        | *\n            ~> @i\n        done\n    done\n    $( @i + 1 ) -> @i\ndone",
    "using <gen 2026>\n;; Fibonacci iteracyjnie — goraca petla trafia do JIT (tier 1 -> Cranelift)\n\n% a: int = 0\n% b: int = 1\n% n: int = 0\n% t: int = 0\n?~ @n < 80\n    $( @a + @b ) -> @t\n    % a = @b\n    % b = @t\n    $( @n + 1 ) -> @n\ndone\n~> fib(80) = @a",
    "using <gen 2026>\n;; liczby pierwsze < 3000 dzieleniem probnym — zagniezdzone petle (regiony natywne)\n\n% n: int = 2\n% count: int = 0\n% last: int = 0\n?~ @n < 3000\n    % d: int = 2\n    % dd: int = 4\n    % prime: int = 1\n    ?~ @dd <= @n\n        $( @n % @d ) -> @r\n        ? switch @r\n        | 0\n            % prime = 0\n            % dd = @n + 1\n        done\n        $( @d + 1 ) -> @d\n        $( @d * @d ) -> @dd\n    done\n    ? switch @prime\n    | 1\n        $( @count + 1 ) -> @count\n        % last = @n\n    done\n    $( @n + 1 ) -> @n\ndone\n~> pierwszych: @count, ostatnia: @last",
    "using <gen 2026>\n;; algorytm Euklidesa (NWD) i NWW dla kilku par\n\n: gcd def\n    % _x: int = @_a\n    % _y: int = @_b\n    % _t: int = 0\n    ?~ @_y > 0\n        $( @_x % @_y ) -> @_t\n        % _x = @_y\n        % _y = @_t\n    done\n    % _g = @_x\ndone\n\n% _a: int = 48\n% _b: int = 18\n-- gcd\n$( @_a * @_b / @_g ) -> @_l\n~> NWD(48,18)=@_g NWW=@_l\n\n% _a: int = 1071\n% _b: int = 462\n-- gcd\n~> NWD(1071,462)=@_g\n\n% _a: int = 17\n% _b: int = 5\n-- gcd\n~> NWD(17,5)=@_g",
    "using <gen 2026>\n;; hipoteza Collatza: dlugosc ciagu dla 27 i 97 (dzielenie niedokladne => deoptymalizacja JIT, wynik ten sam)\n\n: collatz def\n    % _n: int = @_start\n    % _steps: int = 0\n    ?~ @_n > 1\n        $( @_n % 2 ) -> @_odd\n        ? switch @_odd\n        | 0\n            $( @_n / 2 ) -> @_n\n        | *\n            $( @_n * 3 + 1 ) -> @_n\n        done\n        $( @_steps + 1 ) -> @_steps\n    done\ndone\n\n% _start: int = 27\n-- collatz\n~> collatz(27) = @_steps krokow\n\n% _start: int = 97\n-- collatz\n~> collatz(97) = @_steps krokow",
    "using <gen 2026>\n;; trzy gorace petle — po 40 iteracjach kazda trafia do JIT (tier 2: kod natywny z Cranelift)\n;; porownanie:  hlpp --no-jit templates/jit_bench.hl++   |   hlpp --stats templates/jit_bench.hl++\n;; analiza:     hlpp jit templates/jit_bench.hl++ --ir\n\n% i: int = 0\n% s: int = 0\n?~ @i < 200000\n    $( @s + @i * 2 ) -> @s\n    $( @i + 1 ) -> @i\ndone\n~> suma = @s\n\n% a: int = 0\n_300000 $( @a + 7 ) -> @a\n~> a = @a\n\n% x: int = 0\n% y: int = 0\n?~ @x < 400\n    % y = 0\n    ?~ @y < 400\n        $( @y + 1 ) -> @y\n    done\n    $( @x + 1 ) -> @x\ndone\n~> x=@x y=@y",
    "using <gen 2026>\n% i = 0\n% s = 0\n?~ @i < 100000\n  $( @s + @i * 2 ) -> @s\n  $( @i + 1 ) -> @i\ndone\n~> sum=@s\n: hello def\n  ~> hello from a function\ndone\n-- hello",
    "using <gen 2026>\n:+ Animal def\n  % name = \"?\"\n  % sound = \"...\"\n  :. speak def\n    /> echo \"@self.name says @self.sound\"\n  done\ndone\n:+ Dog < Animal def\n  % sound = \"woof\"\n  :. fetch def\n    /> echo \"@self.name fetches\"\n  done\ndone\n+> Dog rex\n% rex.name = \"Rex\"\n.> rex speak\n.> rex fetch\n:- rex",
    "using <gen 2026>\n;; obiekt z polem i metodami z parametrami; dwa niezalezne obiekty\n\n:+ Counter def\n  % n = 0\n  :. inc by def\n    $( @self.n + @by ) -> @self.n\n  done\n  :. dec by def\n    $( @self.n - @by ) -> @self.n\n  done\n  :. show def\n    ~> n=@self.n\n  done\ndone\n\n+> Counter a\n+> Counter b\n.> a inc 5\n.> a inc 7\n.> b inc 100\n.> b dec 1\n.> a show\n.> b show\n:- a\n:- b",
    "using <gen 2026>\n;; dziedziczenie: klasa potomna dostaje pola i metody rodzica\n\n:+ Shape def\n  % name = shape\n  % sides = 0\n  :. describe def\n    ~> @self.name ma @self.sides bokow\n  done\ndone\n\n:+ Triangle < Shape def\n  % name = trojkat\n  % sides = 3\ndone\n\n:+ Square < Shape def\n  % name = kwadrat\n  % sides = 4\n  :. area side def\n    $( @side * @side ) -> @a\n    ~> pole kwadratu o boku @side = @a\n  done\ndone\n\n+> Triangle t\n+> Square s\n.> t describe\n.> s describe\n.> s area 7\n:- t\n:- s",
    "using <gen 2026>\n;; konto bankowe: stan, wplaty, wyplaty\n\n:+ Account def\n  % owner = ?\n  % balance = 0\n  :. deposit amount def\n    $( @self.balance + @amount ) -> @self.balance\n    ~> @self.owner wplata @amount => saldo @self.balance\n  done\n  :. withdraw amount def\n    $( @self.balance - @amount ) -> @self.balance\n    ~> @self.owner wyplata @amount => saldo @self.balance\n  done\ndone\n\n+> Account acc\n% acc.owner = Ala\n.> acc deposit 500\n.> acc deposit 250\n.> acc withdraw 100\n:- acc",
    "using <gen 2026>\n;; import pliku z funkcjami: \"<< sciezka\" (wzgledem katalogu skryptu)\n<< lib/mathlib.hl++\n\n% _v: int = 14\n-- triple\n~> triple(14) = @_t\n\n% _v: int = 250\n% _lo: int = 0\n% _hi: int = 100\n-- clamp\n~> clamp(250, 0..100) = @_c\n\n% _v: int = -5\n-- clamp\n~> clamp(-5, 0..100) = @_c",
    "using <gen 2026>\n;; wbudowane narzedzia \"/>\" (wieloplatformowe, bez zewnetrznych programow)\n\n% _dir = /tmp/hlpp_template_demo\n/> rm -rf @_dir\n/> mkdir -p @_dir\n/> touch @_dir/b.txt\n/> touch @_dir/a.txt\n/> touch @_dir/c.log\n\n~> pliki w katalogu:\n/> ls @_dir\n\n::exists @_dir/a.txt\n? ok\n    ~> a.txt istnieje\ndone\n::exists @_dir/nope.txt\n? err\n    ~> nope.txt nie istnieje\ndone\n\n/> rm -rf @_dir",
    "using <gen 2026>\n;; showcase: przeglad jezyka Hacker Lang++ w jednym pliku\n;; (zmienne, arytmetyka, petle + JIT, funkcje, switch, napisy, komendy, OOP)\n\n~> --- zmienne i arytmetyka ---\n% name = Hacker Lang++\n% n: int = 6\n$( @n * 7 ) -> @answer\n~> @name: @n * 7 = @answer\n\n~> --- petla while (JIT) ---\n% i: int = 1\n% fact: int = 1\n?~ @i <= 10\n    $( @fact * @i ) -> @fact\n    $( @i + 1 ) -> @i\ndone\n~> 10! = @fact\n\n~> --- powtorzenie _N ---\n% k: int = 0\n_1000 $( @k + 2 ) -> @k\n~> k = @k\n\n~> --- funkcja ---\n: cube def\n    $( @_x * @_x * @_x ) -> @_out\ndone\n% _x: int = 5\n-- cube\n~> 5^3 = @_out\n\n~> --- switch ---\n% day = tue\n? switch @day\n| mon\n    ~> poniedzialek\n| tue\n    ~> wtorek\n| *\n    ~> inny dzien\ndone\n\n~> --- napisy ---\n::upper hacker |> @up\n::len @up |> @ln\n~> @up (@ln znakow)\n\n~> --- komenda zewnetrzna i status ---\n> true\n? ok\n    ~> true -> sukces\ndone\n> false\n? err\n    ~> false -> blad (kod @_exit)\ndone\n\n~> --- OOP ---\n:+ Greeter def\n  % who = swiat\n  :. hello def\n    ~> Czesc, @self.who!\n  done\ndone\n+> Greeter g\n.> g hello\n:- g"
]


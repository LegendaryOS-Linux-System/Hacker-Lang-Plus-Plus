]

let src_sum = "using <gen 2026>\n;; petla while: suma 0..99999 (goracy region -> JIT)\n% i: int = 0\n% sum: int = 0\n?~ @i < 100000\n    $( @sum + @i ) -> @sum\n    $( @i + 1 ) -> @i\ndone\n~> sum=@sum i=@i"
let ir_text = "  $0 = @i ( read write )\n  $1 = @sum ( read write )\n  0   tick     w0   ;; guard x0\n  1   jgei     $0, #100000 -> 9\n  2   add      $1 = $1, $0   ;; guard x1\n  3   nop      \n  4   setx     \n  5   addi     $0 = $0, #1   ;; guard x2\n  6   nop      \n  7   setx     \n  8   jmp      -> 0\n  9   setx     \n  10  printfmt fmt#0\n  11  setx     \n  12  exit     x3"
let clif_text = "function %region_3(i64, i64, i64, i64, i64, i64) -> i64 system_v {\nblock0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64):\n    v6 = ireduce.i32 v5\n    br_table v6, block14, [block19, block14, block14, block14, block14, block14, block14, block14, block14, block14, block14, block20, block14]\nblock19:\n    v7 = load.i64 notrap aligned v0+0\n    v8 = load.i64 notrap aligned v0+8\n    v9 = load.i64 notrap aligned v2+0\n    v10 = load.i64 notrap aligned v2+8\n    v11 = load.i64 notrap aligned v3+0\n    v12 = load.i64 notrap aligned v4+0\n    v13 = load.i64 notrap aligned v4+8\n    jump block1(v7, v8, v9, v10, v11, v12, v13)\nblock20:\n    v14 = load.i64 notrap aligned v0+0\n    v15 = load.i64 notrap aligned v0+8\n    v16 = load.i64 notrap aligned v2+0\n    v17 = load.i64 notrap aligned v2+8\n    v18 = load.i64 notrap aligned v3+0\n    v19 = load.i64 notrap aligned v4+0\n    v20 = load.i64 notrap aligned v4+8\n    jump block12(v14, v15, v16, v17, v18, v19, v20)\nblock1(v21: i64, v22: i64, v23: i64, v24: i64, v25: i64, v26: i64, v27: i64):\n    v28 = icmp_imm slt v23, 1000000\n    brif v28, block21, block15(v21, v22, v23, v24, v25, v26, v27)\nblock21:\n    v29 = iadd_imm v23, 1\n    v30 = iadd_imm v27, 1\n    v31 = icmp_imm sge v21, 100000\n    brif v31, block10(v21, v22, v29, v24, v25, v26, v30), block3(v21, v22, v29, v24, v25, v26, v30)\nblock3(v32: i64, v33: i64, v34: i64, v35: i64, v36: i64, v37: i64, v38: i64):\n    v40 = icmp_imm slt v33, 1000000000000000000\n    v41 = icmp_imm sgt v33, -1000000000000000000\n    v42 = band v40, v41\n    ;; ... (dalej: guardy, magazynowanie zmiennych, wyjscia z regionu)"


let nav_paths = ["/", "/jezyk", "/jit", "/przyklady", "/budowanie", "/testy"]
let nav_names = ["Start", "Jezyk", "JIT", "Przyklady", "Budowanie", "Testy"]
let nav_els = []
let jit_btns = []
let ex_btns = []

!! zaznacza aktywny link nawigacji (podstawowy mostek nie ma nav_link)
fun zaznacz(sciezka: Str) [
    let i = 0
    for el_nav in nav_els [
        if nav_paths[i] == sciezka [
            dom_attr(el_nav, "class", "nav-link active")
        ] else [
            dom_attr(el_nav, "class", "nav-link")
        ]
        i = i + 1
    ]
]

!! ── pomocnicze ──────────────────────────────────────────────────────────────
fun kod(rodzic, tekst: Str, klasa: Str) [
    let p = child(rodzic, "pre", "")
    dom_attr(p, "class", klasa)
    dom_text(p, tekst)
    end p
]

fun karta(rodzic, tytul: Str, tekst: Str, klasa: Str) [
    let k = child(rodzic, "div", "")
    dom_attr(k, "class", klasa)
    child(k, "h3", tytul)
    child(k, "p", tekst)
    end k
]

fun odznaka(rodzic, glowny: Str, reszta: Str) [
    let o = child(rodzic, "span", "")
    dom_class(o, "odznaka")
    child(o, "b", glowny)
    child(o, "span", " " + reszta)
]

fun tabela(rodzic, kol1: Str, kol2: Str, lewa, prawa) [
    let t = child(rodzic, "table", "")
    let h = child(t, "tr", "")
    child(h, "th", kol1)
    child(h, "th", kol2)
    let i = 0
    for x in lewa [
        let w = child(t, "tr", "")
        let a = child(w, "td", x)
        dom_class(a, "sk")
        child(w, "td", prawa[i])
        i = i + 1
    ]
]

!! ── strony ──────────────────────────────────────────────────────────────────
fun strona_start() [
    zaznacz("/")
    let out = route_outlet()
    let hero = child(out, "section", "")
    dom_class(hero, "hero")
    child(hero, "p", "Hacker Lang++  0.2.0")
    child(hero, "h2", "Skrypty jak w Hacker Lang. Petle jak w kompilatorze.")
    let lead = child(hero, "p", "Hacker Lang++ (hlpp) uruchamia te same programy co hl, dodaje OOP i wieloplatformowe narzedzia. Jest tylko interpretowany: bytecode VM, a goraca petla zamienia sie w kod natywny generowany w pamieci przez Cranelift. Zadnej kompilacji AOT.")
    dom_class(lead, "lead")
    let od = child(hero, "div", "")
    dom_class(od, "odznaki")
    odznaka(od, "tier 0", "bytecode VM")
    odznaka(od, "tier 1", "IR regionow + deoptymalizacja")
    odznaka(od, "tier 2", "Cranelift (bit.io)")
    odznaka(od, "OOP", "klasy, dziedziczenie")
    odznaka(od, "0 AOT", "wszystko w czasie dzialania")
    let s = child(out, "div", "")
    dom_class(s, "siatka")
    karta(s, "Bytecode VM", "Kompilator tworzy kod HLPB (podglad: hlpp dump plik), a petla dispatch wykonuje go instrukcja po instrukcji.", "karta")
    karta(s, "JIT w trzech warstwach", "Po 40 iteracjach petla ?~ lub _N jest lowerowana do IR, a potem do CLIF i kompilowana przez Cranelift.", "karta")
    karta(s, "Napisany w H#", "Caly interpreter to zrodla .h#. Cranelift wchodzi przez biblioteke bit.io i API hlib.", "karta")
    karta(s, "Testy w Hacker Lang++", "Testy dymne, roznicowe i spojnosci warstw sa pisane w samym jezyku, nie w shellu.", "karta")
    child(out, "h2", "Hello world")
    kod(out, ex_kod[0], "kod")
    kod(out, ex_wyj[0], "kod wyj")
    let a = child(out, "p", "Chcesz zobaczyc wiecej? Wejdz w Przyklady — 19 dzialajacych programow z ich wyjsciem.")
    dom_class(a, "lead")
]

fun strona_jezyk() [
    zaznacz("/jezyk")
    let out = route_outlet()
    child(out, "h2", "Skladnia w pigulce")
    let p = child(out, "p", "Gen 2026 to domyslny dialekt. Ponizej konstrukcje, ktore faktycznie dzialaja w tej wersji (sprawdzone na przykladach z zakladki Przyklady).")
    dom_class(p, "lead")
    tabela(out, "Skladnia", "Znaczenie", syn_k, syn_o)
    child(out, "h2", "Czego jeszcze nie ma")
    let u = child(out, "div", "")
    dom_class(u, "uwaga")
    dom_html(u, "<b>Warunki w petlach</b> porownuja operandy, nie wyrazenia: <code class=\"in\">?~ @d * @d &lt;= @n</code> nie jest poprawne — policz wynik do zmiennej i porownaj ja. Brak ogolnego <code class=\"in\">if</code>: sluza do tego <code class=\"in\">? ok</code>, <code class=\"in\">? err</code> i <code class=\"in\">? switch</code>.")
]

fun strona_jit() [
    zaznacz("/jit")
    let out = route_outlet()
    child(out, "h2", "Jak dziala JIT")
    let p = child(out, "p", "Hacker Lang++ nie ma trybu AOT. Program zawsze startuje w interpreterze, a o przejsciu do wyzszej warstwy decyduje licznik wejsc w naglowek petli.")
    dom_class(p, "lead")
    let s = child(out, "div", "")
    dom_class(s, "siatka")
    karta(s, "Tier 0 — bytecode VM", "Kompilator tworzy kod HLPB, VM wykonuje go instrukcja po instrukcji. Pracuje zawsze i jest punktem powrotu po deoptymalizacji.", "karta tier")
    karta(s, "Tier 1 — region IR", "Petla (?~ lub _N) jest lowerowana do IR z guardami typu i zakresu, optymalizowana i wykonywana przez interpreter IR. Zlamany guard cofa wykonanie do bytecode.", "karta tier t1")
    karta(s, "Tier 2 — Cranelift", "IR jest zamieniane na tekst CLIF, definiowane w module JIT i wywolywane jako kod natywny na buforze z malloc.", "karta tier t2")
    child(out, "h2", "Przyklad: petla sumujaca")
    kod(out, src_sum, "kod")
    let z = child(out, "div", "")
    dom_class(z, "zakladki")
    jit_btns = []
    let b1 = child(z, "button", "Region IR (tier 1)")
    dom_attr(b1, "class", "zak aktywna")
    dom_on(b1, "click", widok_ir)
    jit_btns.push(b1)
    let b2 = child(z, "button", "CLIF (tier 2)")
    dom_attr(b2, "class", "zak")
    dom_on(b2, "click", widok_clif)
    jit_btns.push(b2)
    let pre = kod(out, ir_text, "kod")
    dom_attr(pre, "id", "widok-jit")
    let n = child(out, "p", "Powyzsze to prawdziwe wyjscie komendy hlpp jit tests/jit/sum_loop.hlpp --ir --clif (skrocone).")
    dom_class(n, "lead")
    child(out, "h2", "Biblioteka cranelift przez hlib")
    let t = child(out, "p", "Cranelift to biblioteka bit.io napisana w HackerScript. Jej .hlib niesie natywna fasade C-ABI, z ktorej H# wola funkcje przez API hlib:")
    dom_class(t, "lead")
    kod(out, "use \"hlib -> cranelift\"\n\nlet jit: int = cl_jit_new()\nlet err: string = cl_define_clif(jit, name, clif_text)\nlet r: int = cl_call_i(jit, name, args)   ;; args: List_Int, wynik i64", "kod")
    child(out, "h2", "Przelaczniki")
    tabela(out, "Opcja", "Efekt", ["hlpp --no-jit plik", "hlpp --no-native plik", "HLPP_NATIVE=0", "HLPP_JIT_THRESHOLD=N", "hlpp jit plik [--ir] [--clif]", "hlpp --stats plik"], ["tylko interpreter bytecode", "tiery 0 i 1, bez Cranelift", "to samo co --no-native, ze zmiennej srodowiskowej", "po ilu wejsciach w naglowek petla jest kompilowana (domyslnie 40)", "analiza: ktore petle sie kompiluja, IR i CLIF", "statystyki: instrukcje, czas, regiony natywne, deopty"])
    child(out, "h2", "Pomiar")
    let m = child(out, "p", "Petla 100 000 iteracji (templates/loops_and_math.hl++), jednorazowy przebieg w srodowisku testowym:")
    dom_class(m, "lead")
    tabela(out, "Tryb", "Wynik", ["--no-jit", "domyslny (tier 2)"], ["1 600 016 instrukcji VM, 50 ms", "633 instrukcje VM, 3 ms (petla poszla do Cranelift)"])
    let u = child(out, "div", "")
    dom_class(u, "uwaga")
    dom_html(u, "<b>Znane ograniczenia.</b> Region JIT rozciaga sie poza petle, wiec gdy po niej jest druga petla ze zmienna jeszcze niezdefiniowana, pierwsza nie wchodzi do JIT (wynik jest poprawny, tylko wolniej). Liczby bliskie granicy zakresu (np. fib(90)) potrafia konczyc sie bledem — do naprawy.")
]

fun widok(i: Int) [
    let pre = dom_get("widok-jit")
    if i == 0 [
        dom_text(pre, ir_text)
    ] else [
        dom_text(pre, clif_text)
    ]
    let k = 0
    for b in jit_btns [
        if k == i [
            dom_attr(b, "class", "zak aktywna")
        ] else [
            dom_attr(b, "class", "zak")
        ]
        k = k + 1
    ]
]

fun widok_ir() [ widok(0) ]
fun widok_clif() [ widok(1) ]

fun pokaz(i: Int) [
    dom_text(dom_get("ex-nazwa"), ex_nazwa[i])
    dom_text(dom_get("ex-kod"), ex_kod[i])
    dom_text(dom_get("ex-wyj"), ex_wyj[i])
    let k = 0
    for b in ex_btns [
        if k == i [
            dom_attr(b, "class", "zak aktywna")
        ] else [
            dom_attr(b, "class", "zak")
        ]
        k = k + 1
    ]
]

fun ex_0() [ pokaz(0) ]
fun ex_1() [ pokaz(1) ]
fun ex_2() [ pokaz(2) ]
fun ex_3() [ pokaz(3) ]
fun ex_4() [ pokaz(4) ]
fun ex_5() [ pokaz(5) ]
fun ex_6() [ pokaz(6) ]
fun ex_7() [ pokaz(7) ]
fun ex_8() [ pokaz(8) ]
fun ex_9() [ pokaz(9) ]
fun ex_10() [ pokaz(10) ]
fun ex_11() [ pokaz(11) ]
fun ex_12() [ pokaz(12) ]
fun ex_13() [ pokaz(13) ]
fun ex_14() [ pokaz(14) ]
fun ex_15() [ pokaz(15) ]
fun ex_16() [ pokaz(16) ]
fun ex_17() [ pokaz(17) ]
fun ex_18() [ pokaz(18) ]

let ex_handlers = [ex_0, ex_1, ex_2, ex_3, ex_4, ex_5, ex_6, ex_7, ex_8, ex_9, ex_10, ex_11, ex_12, ex_13, ex_14, ex_15, ex_16, ex_17, ex_18]

fun strona_przyklady() [
    zaznacz("/przyklady")
    let out = route_outlet()
    child(out, "h2", "Przyklady")
    let p = child(out, "p", "Kazdy program jest uruchamiany w testach w trzech trybach i porownywany bajt w bajt z zapisanym wyjsciem.")
    dom_class(p, "lead")
    let z = child(out, "div", "")
    dom_class(z, "zakladki")
    ex_btns = []
    let i = 0
    for n in ex_nazwa [
        let b = child(z, "button", n)
        if i == 0 [
            dom_attr(b, "class", "zak aktywna")
        ] else [
            dom_attr(b, "class", "zak")
        ]
        dom_on(b, "click", ex_handlers[i])
        ex_btns.push(b)
        i = i + 1
    ]
    let h = child(out, "h3", ex_nazwa[0])
    dom_attr(h, "id", "ex-nazwa")
    let k = kod(out, ex_kod[0], "kod")
    dom_attr(k, "id", "ex-kod")
    child(out, "h3", "Wyjscie")
    let w = kod(out, ex_wyj[0], "kod wyj")
    dom_attr(w, "id", "ex-wyj")
]

fun strona_budowanie() [
    zaznacz("/budowanie")
    let out = route_outlet()
    child(out, "h2", "Budowanie ze zrodel")
    let p = child(out, "p", "Interpreter jest napisany w H#. Do zbudowania potrzebujesz hsharp, hackerc, bit oraz cargo (cargo tylko po to, by zbudowac biblioteke cranelift).")
    dom_class(p, "lead")
    kod(out, "hlpp build.hl++            # bit install + cranelift.hlib + hsharp compile -> dist/hlpp\nhlpp build.hl++ test       # testy\nhlpp build.hl++ jit        # analiza JIT\nhlpp build.hl++ cranelift  # tylko biblioteka cranelift", "kod")
    child(out, "h2", "Co robi build.hl++ krok po kroku")
    tabela(out, "Komenda", "Po co", bld_k, bld_o)
    child(out, "h2", "Targety build.hl++")
    tabela(out, "Target", "Opis", ["(domyslny)", "cranelift", "compile", "check", "test", "jit", "install", "clean"], ["pelny build: zaleznosci, cranelift, kompilacja", "tylko cranelift.hlib z fasada FFI", "tylko hsharp compile src/main.h#", "sam typecheck zrodel", "szablony w 3 trybach + spojnosc warstw JIT", "analiza JIT dla jit_bench", "kopiuje dist/hlpp do /usr/bin/hlpp (sudo)", "usuwa dist/"])
    let u = child(out, "div", "")
    dom_class(u, "uwaga")
    dom_html(u, "<b>Uwaga:</b> pierwszy build biblioteki cranelift trwa kilka minut (kompilacja crate'ow Cranelift). Natywna biblioteka musi byc zbudowana dla tego samego triple'a, dla ktorego H# linkuje program.")
]

fun strona_testy() [
    zaznacz("/testy")
    let out = route_outlet()
    child(out, "h2", "Testy w Hacker Lang++")
    let p = child(out, "p", "Skrypty w tests/ sa napisane w samym jezyku. Zwracaja kod wyjscia 0 tylko gdy wszystko przechodzi.")
    dom_class(p, "lead")
    tabela(out, "Skrypt", "Co sprawdza", ["tests/run_examples.hlpp", "tests/jit_tiers.hlpp", "tests/diff_vs_hl.hlpp", "tests/show.hlpp"], ["kazdy szablon z templates/ w trzech trybach (JIT natywny, --no-native, --no-jit) vs tests/expected/", "programy z tests/jit/ daja to samo w trzech trybach, a wskazane petle maja region natywny", "porownanie z referencyjnym hl: stdout (podzbior ASCII) i kod wyjscia", "pokazuje roznice stdout/stderr hl vs hlpp dla jednego pliku"])
    child(out, "h2", "Uruchamianie")
    kod(out, "hlpp tests/run_examples.hlpp dist/hlpp\nhlpp tests/jit_tiers.hlpp dist/hlpp\nhlpp tests/diff_vs_hl.hlpp /sciezka/do/hl dist/hlpp\nHL=/sciezka/do/hl hlpp tests/show.hlpp plik.hl", "kod")
]

fun main() [
    page_title("Hacker Lang++")
    let root = app_root()
    let h = child(root, "header", "")
    dom_class(h, "top")
    let t = child(h, "h1", "")
    dom_html(t, "Hacker Lang<span>++</span>")
    child(h, "p", "bytecode VM + JIT (Cranelift) + OOP — LegendaryOS")
    let nav = child(root, "nav", "")
    let i = 0
    for p in nav_paths [
        let a = child(nav, "a", nav_names[i])
        dom_attr(a, "href", "#" + p)
        dom_attr(a, "class", "nav-link")
        nav_els.push(a)
        i = i + 1
    ]
    let tresc = child(root, "main", "")
    dom_attr(tresc, "id", "route-outlet")
    let f = child(root, "footer", "")
    dom_html(f, "Hacker Lang++ 0.2.0 — interpreter w H#, Cranelift z bit.io (hlib). Strona zbudowana w HackerScript (<code class=\"in\">use &lt;mode:website&gt;</code>).")
    route("/", strona_start)
    route("/jezyk", strona_jezyk)
    route("/jit", strona_jit)
    route("/przyklady", strona_przyklady)
    route("/budowanie", strona_budowanie)
    route("/testy", strona_testy)
]
